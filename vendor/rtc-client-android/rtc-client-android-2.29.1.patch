+/** WordPlus RTC client: a device moving to the key held at an index (the mesh's clients/android README). */
+@OptIn(ExperimentalCoroutinesApi::class)
+class WordPlusMeshKeysMockE2ETest : MockE2ETest() {
+
+    lateinit var pubDataChannel: MockDataChannel
+
+    override suspend fun connect(joinResponse: LivekitRtc.SignalResponse) {
+        super.connect(joinResponse)
+        val pubPeerConnection = component.rtcEngine().getPublisherPeerConnection() as MockPeerConnection
+        pubDataChannel = pubPeerConnection.dataChannels[RTCEngine.RELIABLE_DATA_CHANNEL_LABEL] as MockDataChannel
+    }
+
+    private fun sentKeyIndex(at: Int): Int =
+        DataPacket.parseFrom(ByteString.copyFrom(pubDataChannel.sentBuffers[at].data)).encryptedPacket.keyIndex
+
+    @Test
+    fun useKeyMovesWhatTheDeviceSendsUnderModuloTheRing() = runTest {
+        room.e2eeOptions = E2EEOptions(keyProvider = NoopKeyProvider())
+        connect()
+        val manager = room.e2eeManager!!
+        manager.dataChannelEncryptionEnabled = true
+        assertNull(manager.senderKeyIndex)
+
+        assertTrue(room.localParticipant.publishData("before".toByteArray()).isSuccess)
+        assertEquals(0, sentKeyIndex(0))
+
+        manager.useKey(17)
+        assertEquals(1, manager.senderKeyIndex)
+        assertTrue(room.localParticipant.publishData("after".toByteArray()).isSuccess)
+        assertEquals(1, sentKeyIndex(1))
+
+        manager.useKey(-1)
+        assertEquals(15, manager.senderKeyIndex)
+    }
+
+    @Test
+    fun aKeyProviderSaysItsRing() {
+        assertEquals(16, NoopKeyProvider().keyRingSize)
+    }
+}
