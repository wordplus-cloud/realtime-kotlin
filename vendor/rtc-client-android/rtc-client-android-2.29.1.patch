+    @Test
+    fun aSourceStoppingByItself() {
+        val watch = SourceWatch()
+        watch.read(100.0, 0.0, true)
+        watch.read(400.0, 10_000.0, true)
+        assertFalse(watch.stalled)
+        // no frame between 10 s and 20 s, nor to 30 s; frames again at 40 s
+        watch.read(400.0, 20_000.0, true)
+        assertTrue(watch.stalled)
+        watch.read(400.0, 30_000.0, true)
+        watch.read(700.0, 40_000.0, true)
+        // counted from the reading before the first without frames to the last without
+        assertEquals(1 to 20_000, watch.take(40_000.0))
+        assertFalse(watch.stalled)
+        // asked while it is stopped: its time so far, the rest next time
+        watch.read(700.0, 50_000.0, true)
+        assertEquals(1 to 15_000, watch.take(55_000.0))
+        // it gave frames again by the next reading: what of the stop came after the ask isn't known, so nothing more
+        watch.read(900.0, 60_000.0, true)
+        assertEquals(0 to 0, watch.take(60_000.0))
+        // a person turning the camera off is no stop
+        watch.read(900.0, 70_000.0, false)
+        watch.read(null, 80_000.0, false)
+        assertFalse(watch.stalled)
+    }
