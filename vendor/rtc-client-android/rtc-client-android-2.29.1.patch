+            // whole again after a trim, once off
+            val whole = svcWhole.remove(id) ?: return@synchronized null
+            return@synchronized MeshSvcTrim.Plan(whole.mode, whole.scale, MeshSvcTrim.spatial(whole.mode))
+        }
+        val whole = svcWhole.getOrPut(id) { MeshSvcTrim.Whole(mode, encoding.scaleResolutionDownBy) }
