+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** WordPlus Mesh (1.0.10): the sizes a camera in one SVC stream sends for what its viewers ask (`camera.svcTrim`). */
+class MeshSvcTrimTest {
+
+    @Test
+    fun modesByTheirFirstSizes() {
+        assertEquals("L3T3_KEY", MeshSvcTrim.mode("L3T3_KEY", 3))
+        assertEquals("L2T3_KEY", MeshSvcTrim.mode("L3T3_KEY", 2))
+        assertEquals("L1T3", MeshSvcTrim.mode("L3T3_KEY", 1))
+        assertEquals("L2T3", MeshSvcTrim.mode("L3T3", 2))
+        assertEquals("L1T2", MeshSvcTrim.mode("L2T2_KEY", 1))
+        assertNull(MeshSvcTrim.mode("nonsense", 1))
+        assertEquals(3, MeshSvcTrim.spatial("L3T3_KEY"))
+        assertEquals(1, MeshSvcTrim.spatial("nonsense"))
+    }
+
+    @Test
+    fun plansByTheLargestAsked() {
+        val whole = MeshSvcTrim.Whole("L3T3_KEY", null)
+        assertEquals(MeshSvcTrim.Plan("L1T3", 4.0, 1), MeshSvcTrim.plan(whole, 0))
+        assertEquals(MeshSvcTrim.Plan("L2T3_KEY", 2.0, 2), MeshSvcTrim.plan(whole, 1))
+        assertEquals(MeshSvcTrim.Plan("L3T3_KEY", null, 3), MeshSvcTrim.plan(whole, 2))
+        // a live cap under the trim's own scale stands; one over it gives way to the trim's
+        assertEquals(MeshSvcTrim.Plan("L2T3_KEY", 3.0, 2), MeshSvcTrim.plan(MeshSvcTrim.Whole("L3T3_KEY", 3.0), 1))
+        assertEquals(MeshSvcTrim.Plan("L1T3", 4.0, 1), MeshSvcTrim.plan(MeshSvcTrim.Whole("L3T3_KEY", 1.5), 0))
+        // two sizes: low is its smaller one
+        assertEquals(MeshSvcTrim.Plan("L1T3", 2.0, 1), MeshSvcTrim.plan(MeshSvcTrim.Whole("L2T3_KEY", null), 0))
+        assertNull(MeshSvcTrim.plan(MeshSvcTrim.Whole("nonsense", null), 0))
+    }
+}
