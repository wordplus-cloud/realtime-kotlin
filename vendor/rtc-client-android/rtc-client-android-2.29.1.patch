+
+import livekit.LivekitRtc
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.math.BigInteger
+
+/** WordPlus Mesh (1.0.5): the receive reports, as @wordplus/rtc-client's own tests have them (room/meshReceivers.test.ts). */
+class MeshReceiversTest {
+    @Test
+    fun receivedVideoAsItPlays() {
+        // libwebrtc gives counts as Long, and 64-bit ones as BigInteger
+        val before = MeshReceivers.totals(
+            mapOf(
+                "packetsReceived" to 1000L, "packetsLost" to 10, "framesDecoded" to 300L, "freezeCount" to 1L,
+                "totalFreezesDuration" to 0.4, "framesDropped" to 2L, "jitterBufferDelay" to 30.0,
+                "jitterBufferEmittedCount" to BigInteger.valueOf(300),
+            ),
+            10_000.0,
+        )
+        val values = mapOf<String, Any?>(
+            "packetsReceived" to 1990L, "packetsLost" to 20, "framesDecoded" to 450L, "freezeCount" to 3L,
+            "totalFreezesDuration" to 1.6, "framesDropped" to 5L, "jitterBufferDelay" to 45.0,
+            "jitterBufferEmittedCount" to BigInteger.valueOf(450), "frameHeight" to 720L,
+        )
+        assertEquals(
+            MeshReceivers.Track("TR_v", "video", fps = 15.0, height = 720, freezes = 2, freezeMs = 1200, dropped = 3, lost = 1.0, jbMs = 100),
+            MeshReceivers.reading("TR_v", true, before, MeshReceivers.totals(values, 20_000.0), MeshReceivers.height(values)),
+        )
+    }
+
+    /** concealment while someone spoke, not while they were silent; audio's jitter buffer delay adds up per sample */
+    @Test
+    fun receivedAudioAsHeard() {
+        val before = MeshReceivers.totals(
+            mapOf(
+                "packetsReceived" to 500L, "packetsLost" to 0, "totalSamplesReceived" to 480_000L, "concealedSamples" to 4_800L,
+                "silentConcealedSamples" to 4_000L, "jitterBufferDelay" to 28_800.0, "jitterBufferEmittedCount" to 480_000L,
+            ),
+            0.0,
+        )
+        // of the 28,800 more made up, 4,800 while silent: 24,000 heard, 5 % of 480,000
+        val now = MeshReceivers.totals(
+            mapOf(
+                "packetsReceived" to 1000L, "packetsLost" to 0, "totalSamplesReceived" to 960_000L, "concealedSamples" to 33_600L,
+                "silentConcealedSamples" to 8_800L, "jitterBufferDelay" to 57_600.0, "jitterBufferEmittedCount" to 960_000L,
+            ),
+            10_000.0,
+        )
+        assertEquals(
+            MeshReceivers.Track("TR_a", "audio", concealed = 5.0, lost = 0.0, jbMs = 60),
+            MeshReceivers.reading("TR_a", false, before, now),
+        )
+    }
+
+    @Test
+    fun nothingFromAFirstReadingOrAReceiverThatStartedOver() {
+        val now = MeshReceivers.totals(mapOf("packetsReceived" to 100L, "packetsLost" to 0), 5_000.0)
+        assertNull(MeshReceivers.reading("TR", true, null, now))
+        assertNull(MeshReceivers.reading("TR", true, now, MeshReceivers.totals(mapOf("packetsReceived" to 50L), 15_000.0)))
+        // a device that keeps no freezes says none
+        val first = MeshReceivers.totals(mapOf("packetsReceived" to 100L, "packetsLost" to 0, "framesDecoded" to 0L), 5_000.0)
+        val later = MeshReceivers.totals(mapOf("packetsReceived" to 400L, "packetsLost" to 0, "framesDecoded" to 150L), 15_000.0)
+        assertEquals(MeshReceivers.Track("TR", "video", fps = 15.0, lost = 0.0), MeshReceivers.reading("TR", true, first, later))
+    }
+
+    // 1.0.7 (rtc-client 1.0.17), 2026-10-24: a browser tab in the background for 16 s, its videos turned off by the page,
+    // showed in the live view as "paused 1× 16.1 s" and "stutters ±870 ms". WebRTC adds a gap to the sum of the gaps and to
+    // their squares whatever it was, a pause's and a freeze's too, as its very length (VideoQualityObserver2).
+    private fun readOn(at: Double, values: Map<String, Any?>) = MeshReceivers.totals(values, at, at)
+
+    private val beforeTheGap = readOn(
+        10_000.0,
+        mapOf(
+            "packetsReceived" to 1000L, "framesDecoded" to 300L, "totalInterFrameDelay" to 10.0, "totalSquaredInterFrameDelay" to 0.5,
+            "pauseCount" to 0L, "totalPausesDuration" to 0.0, "freezeCount" to 0L, "totalFreezesDuration" to 0.0,
+        ),
+    )
+
+    /** turned off at 2 s, back on at 18 s, its first frame at 18.1 s: one gap of 16.1 s, then 50 gaps at 30 and 50 ms in turn */
+    private val backAfterAPause = readOn(
+        20_000.0,
+        mapOf(
+            "packetsReceived" to 2000L, "framesDecoded" to 351L, "totalInterFrameDelay" to 10 + 16.1 + 2,
+            "totalSquaredInterFrameDelay" to 0.5 + 16.1 * 16.1 + 0.085, "pauseCount" to 1L, "totalPausesDuration" to 16.1,
+            "freezeCount" to 0L, "totalFreezesDuration" to 0.0,
+        ),
+    )
+
+    @Test
+    fun aPauseTheDeviceMadeIsToldApart() {
+        val read = MeshReceivers.reading("TR_v", true, beforeTheGap, backAfterAPause, resumedAt = 18_000.0)!!
+        assertEquals(1, read.hiddenGaps)
+        assertEquals(16_100, read.hiddenGapMs)
+        assertNull(read.pauses)
+        assertNull(read.pauseMs)
+        assertEquals(0, read.freezes)
+        assertEquals(0, read.freezeMs)
+        assertTrue("${read.unevenMs}", read.unevenMs!! in 9..11)
+        // a turn-on just before the last reading: its first frame came after it
+        assertEquals(1, MeshReceivers.reading("TR_v", true, beforeTheGap, backAfterAPause, resumedAt = 9_000.0)!!.hiddenGaps)
+    }
+
+    @Test
+    fun aPauseOfAVideoTheDeviceDidNotTurnOffIsTheCalls() {
+        val read = MeshReceivers.reading("TR_v", true, beforeTheGap, backAfterAPause)!!
+        assertEquals(1, read.pauses)
+        assertEquals(16_100, read.pauseMs)
+        assertNull(read.hiddenGaps)
+        assertTrue("${read.unevenMs}", read.unevenMs!! > 2000)
+        // turned back on long before the last reading: that gap was the last reading's
+        assertEquals(1, MeshReceivers.reading("TR_v", true, beforeTheGap, backAfterAPause, resumedAt = 5_000.0)!!.pauses)
+    }
+
+    @Test
+    fun aGapTooShortForAPauseIsToldApartFromTheFreezes() {
+        // off at 16.2 s, on at 18 s: one gap of 1.8 s counted as a freeze, then 205 gaps of 40 ms
+        val after = readOn(
+            20_000.0,
+            mapOf(
+                "packetsReceived" to 2000L, "framesDecoded" to 506L, "totalInterFrameDelay" to 10 + 1.8 + 205 * 0.04,
+                "totalSquaredInterFrameDelay" to 0.5 + 1.8 * 1.8 + 205 * 0.0016, "pauseCount" to 0L, "totalPausesDuration" to 0.0,
+                "freezeCount" to 1L, "totalFreezesDuration" to 1.8,
+            ),
+        )
+        val read = MeshReceivers.reading("TR_v", true, beforeTheGap, after, resumedAt = 18_000.0)!!
+        assertEquals(1, read.hiddenGaps)
+        assertEquals(1800, read.hiddenGapMs)
+        assertEquals(0, read.freezes)
+        assertEquals(0, read.freezeMs)
+        assertEquals(0, read.unevenMs)
+    }
+
+    @Test
+    fun theSpreadIsUnsaidWhenTheGapIsNotKnown() {
+        // two pauses: which gaps they were the totals can't say
+        val two = readOn(
+            20_000.0,
+            mapOf(
+                "packetsReceived" to 2000L, "framesDecoded" to 320L, "totalInterFrameDelay" to 19.5,
+                "totalSquaredInterFrameDelay" to 0.5 + 16 + 25 + 0.1, "pauseCount" to 2L, "totalPausesDuration" to 9.0,
+                "freezeCount" to 0L, "totalFreezesDuration" to 0.0,
+            ),
+        )
+        val read = MeshReceivers.reading("TR_v", true, beforeTheGap, two, resumedAt = 18_000.0)!!
+        assertEquals(2, read.hiddenGaps)
+        assertEquals(9000, read.hiddenGapMs)
+        assertNull(read.pauses)
+        assertNull(read.unevenMs)
+        // a device that counts no pauses or freezes
+        val none = MeshReceivers.reading(
+            "TR_v",
+            true,
+            readOn(10_000.0, mapOf("packetsReceived" to 1000L, "framesDecoded" to 300L, "totalInterFrameDelay" to 10.0, "totalSquaredInterFrameDelay" to 0.5)),
+            readOn(
+                20_000.0,
+                mapOf(
+                    "packetsReceived" to 2000L, "framesDecoded" to 351L, "totalInterFrameDelay" to 28.1,
+                    "totalSquaredInterFrameDelay" to 0.5 + 16.1 * 16.1 + 0.085,
+                ),
+            ),
+            resumedAt = 18_000.0,
+        )!!
+        assertNull(none.unevenMs)
+        assertNull(none.hiddenGaps)
+    }
+
+    @Test
+    fun theDeviceKeepsWhenItTurnedAVideoOffAndOn() {
+        val turns = MeshTurns()
+        turns.sent(true, 1000.0)
+        assertNull(turns.offAt)
+        assertNull(turns.onAt)
+        turns.sent(false, 2000.0)
+        // a size change while off isn't a new turn-off
+        turns.sent(false, 3000.0)
+        assertEquals(2000.0, turns.offAt!!, 0.0)
+        turns.sent(true, 18_000.0)
+        assertNull(turns.offAt)
+        assertEquals(18_000.0, turns.onAt!!, 0.0)
+        turns.sent(true, 19_000.0)
+        assertEquals(18_000.0, turns.onAt!!, 0.0)
+    }
+
+    /** The report where a node reads it: a request with no message, the JSON in its field 1002. */
+    @Test
+    fun receiversInASignalRequest() {
+        val json = MeshReceivers.json(listOf(MeshReceivers.Track("TR_v", "video", fps = 30.0)))
+        assertEquals("""{"tracks":[{"sid":"TR_v","kind":"video","fps":30.0}]}""", json)
+        val request = LivekitRtc.SignalRequest.parseFrom(Mesh.lengthDelimited(MeshReceivers.FIELD, json.encodeToByteArray()))
+        assertEquals("no message of LiveKit's", LivekitRtc.SignalRequest.MessageCase.MESSAGE_NOT_SET, request.messageCase)
+        assertEquals(json, Mesh.lengthDelimitedField(MeshReceivers.FIELD, request.toByteArray())?.decodeToString())
+    }
+}
