+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import kotlin.math.abs
+import kotlin.math.pow
+
+/** WordPlus Mesh (1.0.9): the client's settings from its node, as the wire contract has them (the mesh's
+ * better-messages-server infra/CLIENT-CONFIG.md): each value checked again against the schema compiled in. */
+@RunWith(RobolectricTestRunner::class)
+class MeshSettingsTest {
+    private fun settings(json: String): MeshSettings = MeshSettings.parse(json) ?: error("not settings: $json")
+
+    @Test
+    fun schemaCompiledIn() {
+        assertTrue(MeshSettingsSchema.keys.size > 90)
+        for ((name, key) in MeshSettingsSchema.keys) {
+            if (key.defaultJson != "null") assertNotNull("$name's default", MeshSettingsSchemaDefaults.defaults[name])
+        }
+        assertEquals(64, MeshSettings.NONE.int("mic.kbps"))
+        assertEquals(listOf("h264:hw", "vp8"), MeshSettings.NONE.names("camera.codecs"))
+        assertNull("a null default: the client's own rule", MeshSettings.NONE.names("screen.codecs"))
+        assertEquals(listOf(MeshLayer(180, 200, 30), MeshLayer(360, 600, 30)), MeshSettings.NONE.layers("camera.ladder.720"))
+        assertEquals(MeshSettingClass.LIVE, MeshSettings.keyClass("camera.capHeight"))
+        assertEquals(MeshSettingClass.JOIN, MeshSettings.keyClass("connect.signalTimeoutMs"))
+        assertNull(MeshSettings.keyClass("camera.warp"))
+    }
+
+    @Test
+    fun valuesCheckedAgain() {
+        val s = settings(
+            """
+            {"rev": 57, "applyNow": true, "set": {
+              "mic.kbps": 9000, "camera.capHeight": 720.4, "view.pixelDensityMax": 0.2, "mic.red": 1,
+              "camera.backup": "H264", "camera.svcMode": "nope", "camera.codecs": ["VP9", "h264:sw", "vp9", "av1:hw"],
+              "camera.ladder.720": [{"h": 180, "kbps": 150, "fps": 24}, {"h": 360, "kbps": 500, "fps": 30}],
+              "camera.ladder.1080": [{"h": 540, "kbps": 1200, "fps": 30}, {"h": 270, "kbps": 400, "fps": 30}],
+              "reconnect.delaysMs": [0, 500, 90000], "camera.warp": 9, "check.enabled": false
+            }}
+            """,
+        )
+        assertEquals(57L, s.rev)
+        assertTrue(s.applyNow)
+        assertEquals("held to the range", 256, s.int("mic.kbps"))
+        assertEquals("whole", 720, s.int("camera.capHeight"))
+        assertEquals(1.0, s.number("view.pixelDensityMax")!!, 0.0)
+        assertFalse("1 is no boolean", s.isSet("mic.red"))
+        assertEquals("its default then", true, s.bool("mic.red"))
+        assertEquals("h264", s.word("camera.backup"))
+        assertEquals("a word the key doesn't take: its default", "L3T3_KEY", s.word("camera.svcMode"))
+        assertEquals(listOf("vp9", "av1:hw"), s.names("camera.codecs"))
+        assertEquals(listOf(MeshLayer(180, 150, 24), MeshLayer(360, 500, 30)), s.layers("camera.ladder.720"))
+        assertFalse("layers not smallest first", s.isSet("camera.ladder.1080"))
+        assertEquals(listOf(0, 500, 60000), s.numbers("reconnect.delaysMs"))
+        assertFalse("a key this client doesn't know", s.isSet("camera.warp"))
+        assertEquals(false, s.bool("check.enabled"))
+        assertEquals(MeshCaps(height = 720), s.cameraCaps)
+        assertNull("no revision: not settings", MeshSettings.parse("""{"set": {}}"""))
+        assertNull(MeshSettings.parse("[]"))
+        assertNull(MeshSettings.parse("""{"rev": "3"}"""))
+    }
+
+    @Test
+    fun takenWholeWithWhatChanged() {
+        val a = settings("""{"rev": 3, "set": {"mic.kbps": 48, "camera.capFps": 24}}""")
+        val b = settings("""{"rev": 4, "set": {"mic.kbps": 40, "camera.capHeight": 720}}""")
+        assertEquals(setOf("mic.kbps", "camera.capFps", "camera.capHeight"), b.changed(a))
+        assertEquals("left out of the next message: back to its default", 0, b.int("camera.capFps"))
+        assertTrue("a value equal to the default changes nothing", settings("""{"rev": 5, "set": {"mic.kbps": 64}}""").changed(MeshSettings.NONE).isEmpty())
+    }
+
+    @Test
+    fun speaksOnlyWithADocumentOrTheKeySet() {
+        assertFalse(MeshSettings.NONE.speaks("mic.kbps"))
+        val overridesOnly = settings("""{"rev": 0, "set": {"camera.capHeight": 720}}""")
+        assertTrue(overridesOnly.speaks("camera.capHeight"))
+        assertFalse("no document: a product keeps its own value", overridesOnly.speaks("mic.kbps"))
+        assertTrue("a document: the schema's default", settings("""{"rev": 2, "set": {}}""").speaks("mic.kbps"))
+    }
+
+    @Test
+    fun probeTargetsAndJoinParam() {
+        val s = settings(
+            """
+            {"rev": 1, "set": {"probe.enabled": true}, "probe": [
+              {"region": "fr", "url": "wss://n-a.rtc.wordplus.cloud:443/rtc?x=1"}, {"region": "lim", "url": "https://n-b.rtc.wordplus.cloud"},
+              {"region": "Bad Region", "url": "https://n-c"}, {"region": "x", "url": "ftp://n-d"}
+            ]}
+            """,
+        )
+        assertEquals(listOf("fr", "lim"), s.probe.map { it.region })
+        assertEquals("https://n-a.rtc.wordplus.cloud:443", s.probe.first().url)
+
+        val context = RuntimeEnvironment.getApplication()
+        MeshProbe.keep(context, mapOf("lim" to 18, "fr" to 12, "Bad" to 3), "wifi", 20)
+        assertEquals("fr:12,lim:18", MeshProbe.joinParam(context, "wifi"))
+        assertNull("another network's measure isn't this one's", MeshProbe.joinParam(context, "cellular"))
+        assertNull("past probe.cacheMin", MeshProbe.joinParam(context, "wifi", System.currentTimeMillis() + 21 * 60_000))
+    }
+
+    @Test
+    fun probeMeasuresTheFastestOnAnOpenConnection() {
+        val server = MockWebServer()
+        repeat(4) { server.enqueue(MockResponse().setResponseCode(204)) }
+        server.start()
+        try {
+            val ms = MeshProbe.roundTrip(server.url("/").toString().trimEnd('/'), 3)
+            assertNotNull(ms)
+            assertTrue(ms!! in 1..5000)
+            assertEquals("/mesh/ping", server.takeRequest().path)
+            assertEquals("one to open the connection and three measured", 4, server.requestCount)
+        } finally {
+            server.shutdown()
+        }
+        assertNull("a node that doesn't answer", MeshProbe.roundTrip("http://127.0.0.1:1", 3))
+    }
+
+    @Test
+    fun keptPerServerForSevenDays() {
+        val context = RuntimeEnvironment.getApplication()
+        val now = System.currentTimeMillis()
+        MeshSettings.keep(context, """{"rev": 9, "set": {"connect.signalTimeoutMs": 15000}}""", "wss://rtc.wordplus.cloud", now)
+        assertEquals(15000, MeshSettings.cached(context, "wss://rtc.wordplus.cloud", now + 3_600_000)?.int("connect.signalTimeoutMs"))
+        assertNull(MeshSettings.cached(context, "wss://rtc.wordplus.cloud", now + 8 * 86_400_000L))
+        assertNull(MeshSettings.cached(context, "wss://other.example", now))
+    }
+
+    @Test
+    fun messagesOnTheWire() {
+        val json = """{"rev":2,"set":{}}"""
+        val join = Mesh.lengthDelimited(Mesh.CODEC_POLICY_FIELD, "{}".encodeToByteArray()) + Mesh.lengthDelimited(Mesh.SETTINGS_JOIN_FIELD, json.encodeToByteArray())
+        assertEquals(json, Mesh.settingsInJoinResponse(join))
+        assertEquals(json, Mesh.settingsInSignalMessage(Mesh.lengthDelimited(Mesh.SETTINGS_FIELD, json.encodeToByteArray())))
+        assertNull(Mesh.settingsInSignalMessage(Mesh.lengthDelimited(Mesh.REPORTS_FIELD, json.encodeToByteArray())))
+        assertTrue(Mesh.CAPS.split(",").contains("settings"))
+        assertEquals(listOf(0L, 300L, 1200L), MeshSettings.NONE.reconnectDelaysMs?.take(3))
+    }
+
+    @Test
+    fun sourcesDryOnTheWire() {
+        fun said(text: String) = Mesh.lengthDelimited(Mesh.SOURCES_DRY_FIELD, text.encodeToByteArray())
+        assertEquals(setOf("TR_a", "TR_b"), Mesh.sourcesDryInSignalMessage(said("""{"dry":["TR_a","TR_b"]}""")))
+        assertEquals(emptySet<String>(), Mesh.sourcesDryInSignalMessage(said("""{"dry":[]}""")))
+        assertNull(Mesh.sourcesDryInSignalMessage(said("""{"other":1}""")))
+        assertNull(Mesh.sourcesDryInSignalMessage(said("not json")))
+        assertNull(Mesh.sourcesDryInSignalMessage(Mesh.lengthDelimited(Mesh.SETTINGS_FIELD, """{"dry":[]}""".encodeToByteArray())))
+        assertTrue(Mesh.CAPS.split(",").contains("source-dry"))
+    }
+
+    private fun layer(rid: String, scale: Double, kbps: Int, fps: Int = 30) =
+        RtpParameters.Encoding(rid, true, scale).apply {
+            maxBitrateBps = kbps * 1000
+            maxFramerate = fps
+        }
+
+    @Test
+    fun capsOverTheLadder() {
+        var ladder = listOf(layer("q", 4.0, 400), layer("h", 2.0, 1200), layer("f", 1.0, 3500))
+        var off = MeshCaps(height = 720).apply(ladder, 1080)
+        assertTrue(off.isEmpty())
+        assertEquals("the top layer scaled down to 720", 1.5, ladder[2].scaleResolutionDownBy!!, 1e-9)
+        assertTrue("and its bitrate with it", abs(ladder[2].maxBitrateBps!! - 3_500_000 * (720.0 / 1080).pow(1.5)) < 2)
+        assertEquals("540 untouched", 2.0, ladder[1].scaleResolutionDownBy!!, 0.0)
+
+        ladder = listOf(layer("q", 4.0, 400), layer("h", 2.0, 1200), layer("f", 1.0, 3500))
+        off = MeshCaps(height = 540).apply(ladder, 1080)
+        assertEquals("a lower layer covers the cap: the top goes off", setOf("f"), off)
+        assertFalse(ladder[2].active)
+
+        ladder = listOf(layer("q", 4.0, 400), layer("h", 2.0, 1200), layer("f", 1.0, 3500))
+        assertTrue(MeshCaps(fps = 15, kbps = 1000).apply(ladder, 1080).isEmpty())
+        assertTrue(ladder.all { it.maxFramerate == 15 })
+        assertEquals(listOf(400_000, 1_000_000, 1_000_000), ladder.map { it.maxBitrateBps })
+
+        val svc = listOf(RtpParameters.Encoding(null, true, 1.0).apply { maxBitrateBps = 2_800_000 })
+        assertTrue("one stream is scaled whole, never turned off", MeshCaps(height = 360).apply(svc, 1080).isEmpty())
+        assertEquals(3.0, svc[0].scaleResolutionDownBy!!, 1e-9)
+        assertTrue(MeshCaps().apply(ladder, 1080).isEmpty())
+
+        // the server's and the product's own: the stricter of each
+        assertEquals(MeshCaps(540, 24, 2000), MeshCaps(720, 0, 2000).combined(MeshCaps(540, 24)))
+        assertEquals(MeshCaps(), MeshCaps().combined(MeshCaps()))
+    }
+
+    @Test
+    fun republishSpreadOverAMinute() {
+        val delays = (0 until 200).map { MeshSettings.republishDelayMs("user_$it") }
+        assertTrue(delays.all { it in 0 until 60_000 })
+        assertTrue("spread, not bunched", delays.toSet().size > 150)
+        assertEquals("the same for the same identity", MeshSettings.republishDelayMs("user_1"), MeshSettings.republishDelayMs("user_1"))
+    }
+
+    // 1.0.9: no camera for `watch.idleEndMin` ends the hardware-drop watch; the next camera starts it again
+    @Test
+    fun hardwareDropWatchEndsWithoutACamera() {
+        val watch = MeshHardwareDropWatch(
+            context = RuntimeEnvironment.getApplication(),
+            camera = { null },
+            pathUp = { false },
+            statsOf = { null },
+        )
+        watch.start()
+        assertTrue(watch.running)
+        val tune = HardwareDropRule.Tune.of(MeshSettings.parse("""{"rev":1,"set":{"watch.idleEndMin":2}}""")!!)
+        assertEquals(120_000L, tune.idleEndMs)
+        assertEquals("no document: 10 minutes", 600_000L, HardwareDropRule.Tune.of(MeshSettings.NONE).idleEndMs)
+        val t0 = 1_800_000_000_000L
+        watch.idle(tune, t0)
+        watch.idle(tune, t0 + 119_999)
+        assertTrue("under 2 minutes without a camera", watch.running)
+        watch.idle(tune, t0 + 120_000)
+        assertFalse("2 minutes: ended", watch.running)
+        watch.start()
+        assertTrue("a camera published starts it again", watch.running)
+        watch.stop()
+    }
+
+    @Test
+    fun degradationWords() {
+        assertEquals(RtpParameters.DegradationPreference.BALANCED, MeshSettings.degradation("balanced"))
+        assertEquals(RtpParameters.DegradationPreference.MAINTAIN_FRAMERATE, MeshSettings.degradation("maintain-framerate"))
+        assertEquals(RtpParameters.DegradationPreference.MAINTAIN_RESOLUTION, MeshSettings.degradation("maintain-resolution"))
+        assertNull("the publish's own", MeshSettings.degradation("default"))
+        assertNull(MeshSettings.degradation(null))
+    }
+}
