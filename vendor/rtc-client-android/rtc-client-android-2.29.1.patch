+package io.livekit.android.room
+
+import io.livekit.android.room.MeshEncoders.Layer
+import io.livekit.android.room.MeshEncoders.Outbound
+import io.livekit.android.room.MeshEncoders.Totals
+import livekit.LivekitRtc
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.math.BigInteger
+
+/** WordPlus Mesh (1.0.2): the encoder reports, as @wordplus/rtc-client's own tests have them (room/meshEncoders.test.ts). */
+class MeshEncodersTest {
+
+    private fun layer(
+        rid: String,
+        height: Int,
+        encoder: String? = null,
+        fps: Double? = null,
+        limit: String? = null,
+        encodeMs: Double? = null,
+        keyFrames: Int? = null,
+        plis: Int? = null,
+    ) = Outbound(rid, height, encoder, null, true, fps, limit, null, "video/H264", encodeMs, keyFrames, plis)
+
+    @Test
+    fun encodersOfAnAdapter() {
+        val name = "SimulcastEncoderAdapter (OpenH264, VideoToolbox, VideoToolbox)"
+        assertEquals(listOf("OpenH264", "VideoToolbox", "VideoToolbox"), MeshEncoders.adapterEncoders(name))
+        // one encoder a layer, the smallest first
+        assertEquals(
+            listOf(Layer("q", "OpenH264", false), Layer("h", "VideoToolbox", true), Layer("f", "VideoToolbox", true)),
+            MeshEncoders.layersOf(listOf(layer("f", 1080, name), layer("q", 270, name), layer("h", 540, name)))?.second,
+        )
+    }
+
+    @Test
+    fun encodersOverTheLayersThatEncode() {
+        // a camera whose 540p the server paused (dynacast): the adapter names the encoders of q and f alone
+        val name = "SimulcastEncoderAdapter (OpenH264, VideoToolbox)"
+        assertEquals(
+            listOf(
+                Layer("q", "OpenH264", false, fps = 30, height = 270),
+                Layer("h"),
+                Layer("f", "VideoToolbox", true, fps = 30, height = 1080),
+            ),
+            MeshEncoders.layersOf(
+                listOf(layer("q", 270, name, fps = 30.0), layer("h", 540, name, fps = 0.0), layer("f", 1080, name, fps = 29.6, limit = "none")),
+            )?.second,
+        )
+    }
+
+    @Test
+    fun whatHoldsALayerBack() {
+        val name = "SimulcastEncoderAdapter (libvpx, libvpx)"
+        val read = MeshEncoders.layersOf(listOf(layer("q", 720, name, fps = 15.0, limit = "none"), layer("h", 1080, name, fps = 8.0, limit = "cpu")))
+        assertEquals(Layer("h", "libvpx", false, fps = 8, height = 1080, limit = "cpu"), read?.second?.get(1))
+    }
+
+    @Test
+    fun oneEncoderForEveryLayer() {
+        val name = "SimulcastEncoderAdapter (libvpx, libvpx)"
+        assertEquals(
+            listOf(Layer("q", "libvpx", false), Layer("h", "libvpx", false), Layer("f", "libvpx", false)),
+            MeshEncoders.layersOf(listOf(layer("q", 180, name), layer("h", 360, name), layer("f", 720, name)))?.second,
+        )
+        val amd = "MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)"
+        assertEquals(listOf(Layer("q", amd, true)), MeshEncoders.layersOf(listOf(layer("q", 270, amd)))?.second)
+        assertEquals(false, MeshEncoders.encoderHardware("libvpx", null))
+        assertEquals(false, MeshEncoders.encoderHardware("OpenH264", null))
+        assertEquals(false, MeshEncoders.encoderHardware("libaom", null))
+        assertEquals(true, MeshEncoders.encoderHardware("MediaCodec", null))
+        assertEquals(true, MeshEncoders.encoderHardware(null, true))
+        assertNull(MeshEncoders.encoderHardware(null, null))
+    }
+
+    @Test
+    fun layersOfAnUnnamedEncoder() {
+        val read = MeshEncoders.layersOf(listOf(layer("q", 180, fps = 15.0), layer("h", 360, fps = 15.0)))
+        assertEquals("", read?.first)
+        assertEquals(listOf(Layer("q", fps = 15, height = 180), Layer("h", fps = 15, height = 360)), read?.second)
+        assertNull(MeshEncoders.layersOf(emptyList()))
+    }
+
+    @Test
+    fun sinceTheLastReading() {
+        assertEquals(MeshEncoders.Since(), MeshEncoders.sinceLast(null, Totals(1.0, 30.0, 1.0, 0.0)))
+        // 10 s at 7 frames a second, 52 ms a frame, 6 key frames for 9 requests: a slow encoder in a storm of key frames
+        assertEquals(
+            MeshEncoders.Since(52.0, 6, 9),
+            MeshEncoders.sinceLast(Totals(10.0, 1000.0, 20.0, 30.0), Totals(13.64, 1070.0, 26.0, 39.0)),
+        )
+        // a total the device doesn't keep, or one that went back (a sender started over), says nothing
+        assertEquals(MeshEncoders.Since(keyFrames = 1), MeshEncoders.sinceLast(Totals(frames = 100.0, keyFrames = 5.0), Totals(frames = 40.0, keyFrames = 6.0)))
+        // no frame encoded: no time a frame
+        assertEquals(MeshEncoders.Since(), MeshEncoders.sinceLast(Totals(2.0, 10.0), Totals(2.0, 10.0)))
+    }
+
+    @Test
+    fun readingsOnALayerThatEncodes() {
+        val name = "SimulcastEncoderAdapter (OpenH264, MediaFoundationVideoEncodeAccelerator (AMDh264Encoder))"
+        val read = MeshEncoders.layersOf(
+            listOf(
+                layer("q", 180, name, fps = 3.0, encodeMs = 4.1, keyFrames = 0, plis = 0),
+                layer("h", 360, name, fps = 3.0, encodeMs = 61.5, keyFrames = 6, plis = 9),
+                layer("f", 720, name, fps = 0.0, keyFrames = 0, plis = 0),
+            ),
+        )
+        assertEquals(
+            Layer("h", "MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)", true, 3, 360, null, 61.5, 6, 9),
+            read?.second?.get(1),
+        )
+        assertEquals(Layer("f"), read?.second?.get(2))
+    }
+
+    /** A sender's stats as libwebrtc gives them on Android: three layers, the codec and the source, uint64s as BigInteger. */
+    @Test
+    fun layersFromStats() {
+        fun outbound(rid: String, height: Long, frames: Long, time: Double) = MeshEncoders.Stat(
+            "OT_$rid",
+            "outbound-rtp",
+            mapOf(
+                "kind" to "video", "rid" to rid, "frameHeight" to height, "framesPerSecond" to 30.0,
+                "encoderImplementation" to "SimulcastEncoderAdapter (libvpx, MediaCodec, MediaCodec)",
+                "active" to true, "qualityLimitationReason" to "none", "codecId" to "CO_1", "mediaSourceId" to "SV_1",
+                "totalEncodeTime" to time, "framesEncoded" to frames, "keyFramesEncoded" to 2L,
+                "pliCount" to 1L, "firCount" to 0L, "bytesSent" to BigInteger.valueOf(1_000_000),
+            ),
+        )
+        val codec = MeshEncoders.Stat("CO_1", "codec", mapOf("mimeType" to "video/VP8"))
+        val source = MeshEncoders.Stat("SV_1", "media-source", mapOf("kind" to "video", "framesPerSecond" to 29.97))
+        val audio = MeshEncoders.Stat("OT_a", "outbound-rtp", mapOf("kind" to "audio"))
+
+        val (first, totals) = MeshEncoders.outboundOf(
+            listOf(outbound("q", 180, 300, 0.6), outbound("h", 360, 300, 1.2), outbound("f", 720, 300, 3.0), codec, source, audio),
+            null,
+        )
+        assertEquals("video layers only", 3, first.size)
+        assertEquals(Totals(3.0, 300.0, 2.0, 1.0), totals["f"])
+
+        val (second, _) = MeshEncoders.outboundOf(
+            listOf(outbound("q", 180, 600, 1.2), outbound("h", 360, 600, 2.4), outbound("f", 720, 600, 6.0), codec, source),
+            totals,
+        )
+        val report = MeshEncoders.codecReport(second, null)!!
+        assertEquals("vp8", report.codec)
+        assertEquals(30, report.captured)
+        // and (1.0.6) the 300 frames each encoded since the last reading
+        assertEquals(Layer("q", "libvpx", false, 30, 180, null, 2.0, 0, 0, encoded = 300), report.layers.first())
+        assertEquals(Layer("f", "MediaCodec", true, 30, 720, null, 10.0, 0, 0, encoded = 300), report.layers.last())
+        // a backup's codec by its name
+        assertEquals("h264", MeshEncoders.codecReport(second, "h264")!!.codec)
+    }
+
+    /** The report where a node reads it: a request with no message, the JSON in its field 1001. */
+    @Test
+    fun reportInASignalRequest() {
+        val tracks = listOf(
+            MeshEncoders.TrackReport(
+                "TR_a",
+                listOf(MeshEncoders.CodecReport("vp8", "libvpx", listOf(Layer("q", "libvpx", false)), 30)),
+                MeshEncoders.Mode(1280, 720, 30),
+            ),
+        )
+        val json = MeshEncoders.json(tracks)
+        assertEquals(
+            """{"tracks":[{"sid":"TR_a","codecs":[{"codec":"vp8","encoder":"libvpx","layers":[{"rid":"q","encoder":"libvpx","hw":false}],"captured":30}],"mode":{"width":1280,"height":720,"fps":30}}]}""",
+            json,
+        )
+        val bytes = Mesh.lengthDelimited(MeshEncoders.FIELD, json.encodeToByteArray())
+        val request = LivekitRtc.SignalRequest.parseFrom(bytes)
+        assertEquals("no message of LiveKit's", LivekitRtc.SignalRequest.MessageCase.MESSAGE_NOT_SET, request.messageCase)
+        assertEquals(json, Mesh.lengthDelimitedField(MeshEncoders.FIELD, request.toByteArray())?.decodeToString())
+        // the tag of field 1001, then a long one's length in two bytes
+        assertEquals(
+            listOf(0xCA, 0x3E, 0xAC, 0x02),
+            Mesh.lengthDelimited(MeshEncoders.FIELD, ByteArray(300)).take(4).map { it.toInt() and 0xFF },
+        )
+    }
+}
