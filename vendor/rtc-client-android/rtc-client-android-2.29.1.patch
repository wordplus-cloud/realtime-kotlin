+    // A call on 2026-10-23: one sender's camera arrived at 0 kbit/s 11 times in two hours on a clean
+    // line while every viewer froze; the node couldn't tell its camera, its encoder and its sending queue apart
+    @Test
+    fun whatALayerSentAndWhatItsCodecDid() {
+        val before = Totals(
+            frames = 1000.0, sent = 1000.0, packets = 5000.0, sendDelay = 10.0, resent = 10.0, huge = 1.0,
+            limits = mapOf("none" to 100.0, "cpu" to 2.0, "bandwidth" to 0.0, "other" to 0.0), sourceFrames = 1500.0,
+        )
+        // 10 s: the camera gave 140 frames, the encoder made 70 and 60 went, 1.5 s held back by the CPU
+        val now = Totals(
+            frames = 1070.0, sent = 1060.0, packets = 5500.0, sendDelay = 12.5, resent = 15.0, huge = 3.0,
+            limits = mapOf("none" to 108.5, "cpu" to 3.5, "bandwidth" to 0.0, "other" to 0.0), sourceFrames = 1640.0,
+        )
+        val q = MeshEncoders.sentSince(before, now)
+        assertEquals(MeshEncoders.Sent(70, 60, 500.0, 2.5, 5.0, 2.0, mapOf("cpu" to 1.5), 140.0), q)
+        // the two layers of one codec: the frames its source gave once, the CPU's hold the longest, the queue averaged
+        val h = MeshEncoders.sentSince(
+            before.copy(packets = 9000.0, sendDelay = 40.0),
+            now.copy(packets = 10500.0, sendDelay = 41.5, limits = now.limits!! + ("cpu" to 2.5)),
+        )
+        assertEquals(MeshEncoders.Sending(140, MeshEncoders.Limits(cpu = 1500), 2.0, 0.5, 4), MeshEncoders.sendingOf(listOf(q, h)))
+        assertEquals(MeshEncoders.Sending(), MeshEncoders.sendingOf(listOf(MeshEncoders.Sent())))
+        assertEquals("nothing from a first reading", MeshEncoders.Sent(), MeshEncoders.sentSince(null, now))
+    }
