+        assertEquals("0.7 s of waiting over 350 packets", 2.0, report.queueMs!!, 0.0)
+        val json = MeshEncoders.json(listOf(MeshEncoders.TrackReport("TR", listOf(report), stalls = 1, stallMs = 3000)))
+        assertTrue(json, json.contains(""""stalls":1,"stallMs":3000""") && json.contains(""""limitMs":{"cpu":700}"""))
+    }
