+        watch.tellMachineAgain()
+        assertNotNull(watch.reading(emptyMap(), battery = null, now = t0 + 30_000).machine)
+        // in the background across a reading: counted to it, and on from it
+        watch.visibilityChanged(true, t0 + 35_000)
+        assertEquals(5000, watch.reading(emptyMap(), battery = null, now = t0 + 40_000).hiddenMs)
+        assertEquals(10_000, watch.reading(emptyMap(), battery = null, now = t0 + 50_000).hiddenMs)
+        assertEquals("critical", MeshHealth.pressure(4))
+        assertEquals("fair", MeshHealth.pressure(2))
+        assertEquals("nominal", MeshHealth.pressure(0))
+    }
+
+    @Test
+    fun aConnectionsPath() {
+        fun reading(discarded: Long, asked: Long, answered: Long, changes: Long) = listOf(
+            Stat("T", "transport", mapOf("selectedCandidatePairId" to "P", "selectedCandidatePairChanges" to changes)),
+            Stat(
+                "P", "candidate-pair",
+                mapOf(
+                    "currentRoundTripTime" to 0.083, "availableOutgoingBitrate" to 1_234_000.0, "packetsDiscardedOnSend" to discarded,
+                    "consentRequestsSent" to BigInteger.valueOf(asked), "responsesReceived" to BigInteger.valueOf(answered),
+                ),
+            ),
+        )
+        val (first, totals) = MeshHealth.path(reading(0, 10, 10, 1), null)!!
+        assertEquals(MeshHealth.Path(rtt = 83, outKbps = 1234), first)
+        // Wi-Fi dropping out: packets the system couldn't send, checks unanswered, a new path
+        val (second, _) = MeshHealth.path(reading(40, 16, 12, 2), totals)!!
+        assertEquals(MeshHealth.Path(rtt = 83, outKbps = 1234, sendFailed = 40, unanswered = 4, switched = 1), second)
+        assertNull(MeshHealth.path(listOf(Stat("T", "transport", emptyMap())), null))
+
+        val watch = MeshHealthWatch(null)
+        watch.reading(mapOf("pub" to reading(0, 10, 10, 1)), battery = null)
+        assertEquals(40, watch.reading(mapOf("pub" to reading(40, 16, 12, 2), "sub" to reading(0, 1, 1, 1)), battery = null).pub?.sendFailed)
+    }
+
+    /** The node's pace in a response of its own; the reading's reports in one request, each in its field. */
+    @Test
+    fun paceAndOneRequest() {
+        assertEquals(30_000, Mesh.reportPaceInSignalMessage(Mesh.lengthDelimited(Mesh.REPORTS_FIELD, """{"every":30000}""".encodeToByteArray())))
+        assertEquals(0, Mesh.reportPaceInSignalMessage(Mesh.lengthDelimited(Mesh.REPORTS_FIELD, """{"every":0}""".encodeToByteArray())))
+        assertNull(Mesh.reportPaceInSignalMessage(Mesh.lengthDelimited(Mesh.REGIONS_FIELD, """{"regions":[]}""".encodeToByteArray())))
+        assertNull(Mesh.reportPaceInSignalMessage(Mesh.lengthDelimited(Mesh.REPORTS_FIELD, """{"every":-1}""".encodeToByteArray())))
+
+        val encoders = """{"tracks":[]}"""
+        val receivers = """{"tracks":[{"sid":"TR","kind":"video"}]}"""
+        val health = MeshHealth.json(MeshHealth.Report(cpu = "serious", cpuMs = 1200))
+        assertEquals("""{"cpu":"serious","cpuMs":1200}""", health)
+        val bytes = Mesh.reports(encoders, receivers, health)!!
+        val request = LivekitRtc.SignalRequest.parseFrom(bytes)
+        assertEquals("no message of LiveKit's", LivekitRtc.SignalRequest.MessageCase.MESSAGE_NOT_SET, request.messageCase)
+        assertEquals(encoders, Mesh.lengthDelimitedField(MeshEncoders.FIELD, bytes)?.decodeToString())
+        assertEquals(receivers, Mesh.lengthDelimitedField(MeshReceivers.FIELD, bytes)?.decodeToString())
+        assertEquals(health, Mesh.lengthDelimitedField(MeshHealth.FIELD, bytes)?.decodeToString())
+        assertNull(Mesh.reports(null, null, null))
+    }
+}
