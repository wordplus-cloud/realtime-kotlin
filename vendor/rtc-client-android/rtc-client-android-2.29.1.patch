+/** WordPlus RTC client: a room closing while its connections are busy (the mesh's clients/android README). */
+@OptIn(ExperimentalCoroutinesApi::class)
+class WordPlusMeshTeardownMockE2ETest : MockE2ETest() {
+
+    private val candidate = IceCandidate("0", 0, "candidate:1 1 udp 2130706431 127.0.0.1 7882 typ host")
+
+    private suspend fun subscriberBusyWithAnOffer(): MockPeerConnection {
+        connectSignal()
+        val subscriber = component.rtcEngine().getSubscriberPeerConnection() as MockPeerConnection
+        subscriber.holdRemoteDescriptions = true
+        // Held back until the offer's remote description is set.
+        component.rtcEngine().onTrickle(candidate, LivekitRtc.SignalTarget.SUBSCRIBER)
+        simulateMessageFromServer(TestData.OFFER)
+        coroutineRule.dispatcher.scheduler.runCurrent()
+        assertTrue("the candidate waits for the description", subscriber.candidatesAdded.isEmpty())
+        return subscriber
+    }
+
+    /** A camera going out on the publisher. */
+    private fun cameraOn(publisher: MockPeerConnection): RtpTransceiver {
+        val init = RtpTransceiver.RtpTransceiverInit(RtpTransceiver.RtpTransceiverDirection.SEND_ONLY)
+        return publisher.addTransceiver(MockVideoStreamTrack(), init)
+    }
+
+    @Test
+    fun anEncryptedRoomStopsItsVideoAndWaitsBeforeClosing() = runTest {
+        room.e2eeOptions = E2EEOptions(keyProvider = NoopKeyProvider())
+        connect()
+        val publisher = component.rtcEngine().getPublisherPeerConnection() as MockPeerConnection
+        val sender = cameraOn(publisher).sender
+        var stoppedAt = 0L
+        var stateWhenStopped: PeerConnection.IceConnectionState? = null
+        whenever(sender.setTrack(null, false)).thenAnswer {
+            stoppedAt = System.nanoTime()
+            stateWhenStopped = publisher.iceConnectionState()
+            true
+        }
+
+        room.disconnect()
+        val waited = (System.nanoTime() - stoppedAt) / 1_000_000
+
+        verify(sender).setTrack(null, false)
+        assertNotEquals(PeerConnection.IceConnectionState.CLOSED, stateWhenStopped)
+        assertEquals(PeerConnection.IceConnectionState.CLOSED, publisher.iceConnectionState())
+        assertTrue("waited $waited ms", waited >= Mesh.ENCRYPTED_VIDEO_DRAIN_MS)
+    }
+
+    @Test
+    fun aRoomWithNoKeyClosesAtOnceAsItHasNoFrameTransformer() = runTest {
+        connect()
+        val publisher = component.rtcEngine().getPublisherPeerConnection() as MockPeerConnection
+        val sender = cameraOn(publisher).sender
+        val began = System.nanoTime()
+
+        room.disconnect()
+
+        verify(sender, never()).setTrack(null, false)
+        assertTrue((System.nanoTime() - began) / 1_000_000 < Mesh.ENCRYPTED_VIDEO_DRAIN_MS)
+    }
+
+    @Test
+    fun anEncryptedRoomWithNoVideoSenderClosesAtOnce() = runTest {
+        room.e2eeOptions = E2EEOptions(keyProvider = NoopKeyProvider())
+        connect()
+        val began = System.nanoTime()
+
+        room.disconnect()
+
+        assertTrue((System.nanoTime() - began) / 1_000_000 < Mesh.ENCRYPTED_VIDEO_DRAIN_MS)
+    }
+
+    @Test
+    fun aRemoteDescriptionFinishingAfterTheCloseAddsNoCandidate() = runTest {
+        val subscriber = subscriberBusyWithAnOffer()
+
+        room.disconnect()
+        subscriber.finishRemoteDescription()
+        coroutineRule.dispatcher.scheduler.runCurrent()
+
+        assertEquals(emptyList<IceCandidate?>(), subscriber.candidatesAddedAfterDispose)
+    }
+
+    @Test
+    fun aRemoteDescriptionFinishingWhileOpenAddsItsCandidates() = runTest {
+        val subscriber = subscriberBusyWithAnOffer()
+
+        subscriber.finishRemoteDescription()
+        coroutineRule.dispatcher.scheduler.runCurrent()
+
+        assertEquals(listOf<IceCandidate?>(candidate), subscriber.candidatesAdded)
+    }
+}
