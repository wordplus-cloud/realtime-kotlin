+// WordPlus Mesh: what this client does differently on a mesh's servers, as @wordplus/rtc-client does in a browser
+// (the mesh's clients/js). The protocol is upstream's own; a mesh node answers `/settings/regions` as LiveKit Cloud
+// does, refuses a join it can't place now with HTTP 429, and sends its region list over the signal connection.
+
+/**
+ * The domains a mesh serves: `rtc.wordplus.cloud` and the names under it, and any a product adds.
+ */
+object MeshDomains {
+    private val domains = mutableSetOf("rtc.wordplus.cloud")
+
+    /** Adds domains served by a mesh, beside the built-in ones. */
+    @JvmStatic
+    fun add(vararg list: String) {
+        synchronized(domains) {
+            for (domain in list) {
+                val clean = domain.lowercase().trim('.')
+                if (clean.isNotEmpty()) domains.add(clean)
+            }
+        }
+    }
+
+    internal fun contains(host: String): Boolean = synchronized(domains) {
+        domains.any { host == it || host.endsWith(".$it") }
+    }
+}
+
+/** WordPlus Mesh: a server under a mesh's domain, `rtc.wordplus.cloud` and the names under it. */
+fun URI.isMeshServer(): Boolean = host?.lowercase()?.let { MeshDomains.contains(it) } ?: false
+
+/** WordPlus Mesh: [isMeshServer] for a URL as a string. */
+fun isMeshServer(url: String): Boolean = try {
+    URI(url).isMeshServer()
+} catch (e: Exception) {
+    false
+}
+
+/**
+ * Why a join on a mesh started to wait: every server tried was [BUSY] and a slot is held on one, a node holds a
+ * [SLOT] for it, the cluster is [FULL] (and a slot is held), or no server of the list could be reached at all.
+ */
+enum class MeshWaitReason(val wire: String) {
+    BUSY("busy"),
+    SLOT("slot"),
+    FULL("full"),
+    UNREACHABLE("unreachable"),
+    ;
+
+    companion object {
+        internal fun fromWire(wire: String?): MeshWaitReason? = entries.firstOrNull { it.wire == wire }
+    }
+}
+
+/** A join on a mesh waiting, until when (epoch ms), and why ([ConnectOptions.onMeshWait]). */
+data class MeshWait(val until: Long, val reason: MeshWaitReason)
+
+/**
+ * The product placing a call (1.0.2, rtc-client 1.0.6's `meshApp`), which a mesh node is told on each join of the room
+ * (`rtc_app`) for its live view: `MeshApp("better-messages", "3.1.4")`.
+ */
+data class MeshApp(val name: String, val version: String? = null)
+
+/**
+ * A mesh node's codec policy (1.0.2, rtc-client 1.0.8's `MeshCodecPolicy`), [Room.meshCodecPolicy]: each list the codecs
+ * it would have a camera or a screen go out in, first choice first (`h265:hw` only from hardware), and what goes behind a
+ * camera. A preference: the product takes the first its device sends.
+ *
+ * Since 1.0.6 (rtc-client 1.0.16's, WordPlus Mesh 1.0.53): the node's switches for the product's camera check and its
+ * camera moving to another codec during a call ([check], [adapt]: JSON booleans only, null from a node that says
+ * neither), which nothing in this client acts on, and its numbers by name ([tune]), which the product holds each to its
+ * own range: `failsafeS`, for one, the longest a viewer shows a camera moving to another codec as "Optimizing video
+ * quality...".
+ */
+data class MeshCodecPolicy(
+    val camera: List<String>? = null,
+    val screen: List<String>? = null,
+    val backup: String? = null,
+    val check: Boolean? = null,
+    val adapt: Boolean? = null,
+    /** At most 32, each a name of 24 characters at most and a finite number; null where the node sends no `tune`. */
+    val tune: Map<String, Double>? = null,
+)
+
+/** A mesh node's refusal of a join, from its 429 (`X-Mesh-Refused`, `X-Mesh-Node`, `Retry-After`). */
+data class MeshRefusal(
+    /** `busy`, `slot` or `full`; null from a server that names none. */
+    val kind: String?,
+    /** The refusing node's id, as the region list names it. */
+    val node: String?,
+    /** How long until the node takes the join, in ms, when it said. */
+    val retryAfterMs: Long?,
+) {
+    companion object {
+        internal fun of(kind: String?, node: String?, retryAfter: String?): MeshRefusal = MeshRefusal(
+            kind = kind?.takeIf { it in setOf("busy", "slot", "full") },
+            node = node?.takeIf { it.isNotEmpty() },
+            retryAfterMs = retryAfterMs(retryAfter),
+        )
+
+        /** A Retry-After header in ms: seconds, or an HTTP date; null if neither. */
+        internal fun retryAfterMs(header: String?, now: Long = System.currentTimeMillis()): Long? {
+            val value = header?.trim()?.takeIf { it.isNotEmpty() } ?: return null
+            value.toDoubleOrNull()?.let { if (it >= 0) return (it * 1000).toLong() }
+            return try {
+                val format = SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss zzz", Locale.US)
+                format.timeZone = TimeZone.getTimeZone("GMT")
+                format.parse(value)?.time?.let { maxOf(0L, it - now) }
+            } catch (e: Exception) {
+                null
+            }
+        }
+    }
+}
+
+/**
+ * WordPlus Mesh: a join a mesh node refused for now (HTTP 429), with what it said.
+ */
+class MeshRefusedException(val refusal: MeshRefusal, message: String?, cause: Throwable? = null) :
+    RoomException(message, cause)
+
+/** WordPlus Mesh: the mesh's refusal anywhere in a failed join's causes, or null. */
+fun Throwable.meshRefusal(): MeshRefusal? {
+    var error: Throwable? = this
+    while (error != null) {
+        if (error is MeshRefusedException) return error.refusal
+        error = error.cause.takeIf { it !== error }
+    }
+    return null
+}
+
+internal object Mesh {
+    /** How long a join keeps trying before it reports its last error, unless the product says otherwise. */
+    const val JOIN_BUDGET_MS = 30_000L
+
+    /**
+     * How long a resume waits for its server before moving on, at least: a live node answers within about a second,
+     * even across continents, and a dead one would otherwise hold the attempt past the mesh's hold of its participants.
+     */
+    const val RESUME_TIMEOUT_MS = 5_000L
+
+    /**
+     * How long a resume waits for its server (1.0.1, rtc-client 1.0.5's resumeWaitMs): four of the round trips the
+     * connection last measured, at least [RESUME_TIMEOUT_MS] and at most the connect's own timeout. A connection whose
+     * round trip had grown to seconds, a phone behind a full queue, took 5 s for a server that is gone and moved on
+     * from one that was up (a large audio chat, 2026-10-17: 2 to 28 s).
+     */
+    fun resumeWaitMs(rttMs: Long, capMs: Long): Long = minOf(capMs, maxOf(RESUME_TIMEOUT_MS, 4 * maxOf(rttMs, 0L)))
+
+    /** How long a probe of whether a server answers may take (1.0.1). */
+    const val SERVER_PROBE_TIMEOUT_MS = 3_000L
+
+    /** How many servers a failed resume probes before it stays where it is (1.0.1, rtc-client 1.0.12). */
+    const val RESUME_MOVE_TRIES = 3
+
+    /**
+     * Whether a failed resume goes to another server of the region list (1.0.1, rtc-client 1.0.5): only when its own
+     * server has stopped answering and that one answers. When its own still answers, the server is up and the resume
+     * failed on the way. When neither answers, it is this client's network that is down, and every server would fail
+     * alike: walking the list then took a phone in a call on France's node to Limburg and on to Canada during its own
+     * outage, and kept it there for the rest of the call (a large audio chat, 2026-10-17).
+     */
+    fun resumeMoves(ownAnswers: Boolean, nextAnswers: Boolean): Boolean = !ownAnswers && nextAnswers
+
+    /** Whether two signal URLs name the same server, by host and port (1.0.1, rtc-client 1.0.12). */
+    fun sameServer(a: String, b: String): Boolean = try {
+        val x = URI(a)
+        val y = URI(b)
+        x.host.equals(y.host, ignoreCase = true) && x.port == y.port
+    } catch (e: Exception) {
+        a == b
+    }
+
+    /** A signal URL's origin over HTTP(S), which [RegionUrlProvider.serverAnswers] asks; null for one it can't read. */
+    fun httpOrigin(url: String): String? = try {
+        val uri = URI(url)
+        val scheme = when (uri.scheme?.lowercase()) {
+            "wss", "https" -> "https"
+            "ws", "http" -> "http"
+            else -> null
+        }
+        if (scheme == null || uri.host == null) null else URI(scheme, null, uri.host, uri.port, "/", null, null).toString()
+    } catch (e: Exception) {
+        null
+    }
+
+    /**
+     * How long the region list's fetch, or the validation after a failed join, may take before it counts as
+     * unreachable: stock waits the HTTP client's own, and a dead server held the next attempt that long.
+     */
+    const val REQUEST_TIMEOUT_MS = 3_000L
+
+    /** How long after a join a node has to send its region list before it is fetched instead. */
+    const val REGIONS_WAIT_MS = 3_000L
+
+    /** The mesh's wait when every node is full, if its 429 names none. */
+    const val FULL_RETRY_MS = 5_000L
+
+    /**
+     * How many resumes a reconnect makes on a mesh, each on the list's next server, before a full reconnect: the mesh
+     * takes over a session it doesn't hold, so a resume elsewhere keeps the session where a full reconnect makes a new
+     * one, which the others see leave.
+     */
+    const val RESUME_TRIES = 4
+
+    /**
+     * How long an encrypted room's publisher waits before it closes, its video senders' tracks off (1.0.11). WebRTC's
+     * RTPSenderVideoFrameTransformerDelegate hands each encrypted frame to a task queue of its own, and the task holds a
+     * reference to it. A frame still on its way as the sender is destroyed can leave that task the last reference, and
+     * the delegate then deletes its queue on the queue's own thread. On Android that thread joins itself and the process
+     * aborts (platform_thread.cc, pthread_join, 0 vs. 35, on thread VideoFrameTrans). As of WebRTC M150 nothing guards it,
+     * and no call from here reaches that queue, so this only gives the frames time to leave.
+     */
+    const val ENCRYPTED_VIDEO_DRAIN_MS = 250L
+
+    /** The signal response field a node sends its region list in: one LiveKit's protocol hasn't got. */
+    const val REGIONS_FIELD = 100
+
+    /**
+     * The signal response field a node tells a client how often to send its reports in (1.0.6, rtc-client 1.0.16's
+     * `MESH_REPORTS_FIELD`, WordPlus Mesh 1.0.53): JSON, `{"every": ms}`, 0 for not at all; every 10 s in a small call,
+     * less often in a big room. Any other client skips it.
+     */
+    const val REPORTS_FIELD = 101
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** The pace a signal response asks for the reports at ([REPORTS_FIELD]), ms; null when the message is another. */
+    fun reportPaceInSignalMessage(bytes: ByteArray): Int? {
+        val raw = lengthDelimitedField(REPORTS_FIELD, bytes) ?: return null
+        return try {
+            val every = (json.parseToJsonElement(raw.decodeToString()) as? JsonObject)?.get("every")?.jsonPrimitive?.doubleOrNull
+            every?.takeIf { it.isFinite() && it >= 0 }?.toInt()
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    /**
+     * A reading's reports as one signal request's bytes, each JSON in its own field ([MeshEncoders.FIELD],
+     * [MeshReceivers.FIELD], [MeshHealth.FIELD]); null when there is none.
+     */
+    fun reports(encoders: String?, receivers: String?, health: String?): ByteArray? {
+        val parts = listOfNotNull(
+            encoders?.let { lengthDelimited(MeshEncoders.FIELD, it.encodeToByteArray()) },
+            receivers?.let { lengthDelimited(MeshReceivers.FIELD, it.encodeToByteArray()) },
+            health?.let { lengthDelimited(MeshHealth.FIELD, it.encodeToByteArray()) },
+        )
+        return if (parts.isEmpty()) null else parts.reduce { a, b -> a + b }
+    }
+
+    /**
+     * How long to wait before trying a failed join again, or null when it isn't one to try again or the deadline
+     * comes first: a full mesh after its Retry-After, within a second after it (or 5 s, give or take half); a server
+     * that couldn't be reached after 1 to 3 s.
+     */
+    fun joinRetryMs(error: Throwable, deadline: Long, now: Long = System.currentTimeMillis()): Long? {
+        val refusal = error.meshRefusal()
+        val delay = when {
+            refusal != null -> refusal.retryAfterMs?.let { it + Random.nextLong(1_000) }
+                ?: (FULL_RETRY_MS * (0.5 + Random.nextDouble())).toLong()
+            isRefusedToken(error) -> return null
+            else -> 1_000L + Random.nextLong(2_000)
+        }
+        return if (now + delay < deadline) delay else null
+    }
+
+    /**
+     * A refusal of the token or the room, which no server will take: the validation's 401 or 403, which a failed join
+     * to a mesh's server reports with its status (`SignalClient.onFailure`).
+     */
+    fun isRefusedToken(error: Throwable): Boolean =
+        generateSequence(error) { it.cause.takeIf { cause -> cause !== it } }
+            .any { Regex("^HTTP (401|403)\\b").containsMatchIn(it.message ?: "") }
+
+    /** The busy server to wait on: the home region's that frees first, another region's only if it had none. */
+    fun <T> waitOn(busy: List<T>, home: String?, region: (T) -> String?, freeAt: (T) -> Long): T? {
+        val near = busy.filter { home != null && region(it) == home }
+        return (near.ifEmpty { busy }).minByOrNull(freeAt)
+    }
+
+    /** The server's URL with `mesh_wait=1`, which keeps the join a slot of its own on that node while it waits. */
+    fun withMeshWait(url: String): String {
+        val uri = URI(url)
+        val query = (uri.rawQuery?.split('&')?.filter { it.isNotEmpty() && !it.startsWith("mesh_wait=") } ?: emptyList()) + "mesh_wait=1"
+        return URI(uri.scheme, uri.rawAuthority, uri.rawPath, null, null).toString() + "?" + query.joinToString("&")
+    }
+
+    /** Whether this is a server the join said it will wait on ([withMeshWait]). */
+    fun isMeshWait(url: String): Boolean = try {
+        URI(url).rawQuery?.split('&')?.contains("mesh_wait=1") == true
+    } catch (e: Exception) {
+        false
+    }
+
+    /** The URL without its query, which upstream's signal URL is built on. */
+    fun withoutQuery(url: String): String = try {
+        val uri = URI(url)
+        URI(uri.scheme, uri.rawAuthority, uri.rawPath, null, null).toString()
+    } catch (e: Exception) {
+        url
+    }
+
+    /**
+     * The WordPlus RTC client for Android's own version, which a mesh node is told on each join (`rtc_client`) beside
