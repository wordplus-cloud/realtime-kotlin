+    /** A layer's frames encoded and sent and its target in the report, read from libwebrtc's stats (uint64s as BigInteger). */
+    @Test
+    fun layerSentAndTargetFromStats() {
+        fun outbound(frames: Long, sent: Long, source: Long) = listOf(
+            Stat(
+                "OT", "outbound-rtp",
+                mapOf(
+                    "kind" to "video", "rid" to "f", "framesEncoded" to frames, "framesSent" to sent, "framesPerSecond" to 7.0,
+                    "frameHeight" to 720L, "targetBitrate" to 1_200_000.0, "packetsSent" to BigInteger.valueOf(frames * 5),
+                    "totalPacketSendDelay" to frames * 0.01, "codecId" to "C", "mediaSourceId" to "S",
+                    "qualityLimitationDurations" to mapOf("cpu" to frames / 100.0, "none" to 1.0),
+                ),
+            ),
+            Stat("C", "codec", mapOf("mimeType" to "video/VP8")),
+            Stat("S", "media-source", mapOf("frames" to source, "framesPerSecond" to 14.0)),
+        )
+        val (_, first) = MeshEncoders.outboundOf(outbound(1000, 1000, 1500), null)
+        val (second, _) = MeshEncoders.outboundOf(outbound(1070, 1060, 1640), first)
+        val report = MeshEncoders.codecReport(second, null)!!
+        assertEquals(listOf(MeshEncoders.Layer("f", fps = 7, height = 720, encoded = 70, sent = 60, target = 1200)), report.layers)
+        assertEquals(140, report.frames)
