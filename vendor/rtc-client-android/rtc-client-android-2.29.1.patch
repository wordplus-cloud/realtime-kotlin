+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import java.net.URI
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+@RunWith(RobolectricTestRunner::class)
+class WordPlusMeshTest {
+
+    private val listJson = """{"regions":[
+        {"region":"eu","url":"wss://n1.rtc.wordplus.cloud","distance":"10","node":"n1"},
+        {"region":"eu","url":"wss://n2.rtc.wordplus.cloud","distance":"10","node":"n2"},
+        {"region":"us","url":"wss://n3.rtc.wordplus.cloud","distance":"7000","node":"n3"}
+    ]}"""
+
+    private fun provider(url: String = "wss://rtc.wordplus.cloud") =
+        RegionUrlProvider(URI(url), "token", OkHttpClient.Builder().build(), Json { ignoreUnknownKeys = true })
+
+    @Test
+    fun domains() {
+        assertTrue(isMeshServer("wss://rtc.wordplus.cloud"))
+        assertTrue(isMeshServer("wss://n1.rtc.wordplus.cloud/"))
+        assertTrue(isMeshServer("https://RTC.WordPlus.Cloud"))
+        assertFalse(isMeshServer("wss://rtc.wordplus.cloud.example.com"))
+        assertFalse(isMeshServer("wss://xrtc.wordplus.cloud"))
+        assertFalse(isMeshServer("wss://video.rtc.example.com"))
+        assertFalse(isMeshServer("not a url"))
+
+        MeshDomains.add(".mesh.example.org.")
+        assertTrue(isMeshServer("wss://a.mesh.example.org"))
+        assertTrue(URI("wss://a.mesh.example.org").isLKCloud())
+    }
+
+    @Test
+    fun waitFlag() {
+        val waiting = Mesh.withMeshWait("wss://n1.rtc.wordplus.cloud")
+        assertEquals("wss://n1.rtc.wordplus.cloud?mesh_wait=1", waiting)
+        assertEquals(waiting, Mesh.withMeshWait(waiting))
+        assertTrue(Mesh.isMeshWait(waiting))
+        assertFalse(Mesh.isMeshWait("wss://n1.rtc.wordplus.cloud"))
+        assertEquals("wss://n1.rtc.wordplus.cloud", Mesh.withoutQuery(waiting))
+    }
+
+    @Test
+    fun joinParameters() {
+        val options = ConnectOptions(meshHardwareDecoders = listOf("h264", "vp8"))
+        val client = listOf("rtc_client" to Mesh.CLIENT_VERSION, "mesh_caps" to "audio-pause,codec-policy,settings,source-dry", "device_type" to "phone")
+        assertEquals(
+            listOf("mesh_client" to "1", "mesh_hwdec" to "h264,vp8") + client,
+            Mesh.queryParams("wss://rtc.wordplus.cloud", options),
+        )
+        assertEquals(
+            listOf("mesh_client" to "1") + client + ("mesh_wait" to "1"),
+            Mesh.queryParams("wss://n2.rtc.wordplus.cloud?mesh_wait=1", ConnectOptions()),
+        )
+        assertEquals(emptyList<Pair<String, String>>(), Mesh.queryParams("wss://video.example.com", options))
+    }
+
+    /**
+     * 1.0.2 (rtc-client 1.0.6 to 1.0.8): the client's own version, what it can do, the room's product, the device and
+     * the codecs it encodes in hardware, to a mesh only.
+     */
+    @Test
+    fun joinNamesTheClient() {
+        val options = ConnectOptions(meshHardwareEncoders = listOf("h264"), meshApp = MeshApp("better-messages", "3.1.4"))
+        val params = Mesh.queryParams("wss://n1.rtc.wordplus.cloud", options)
+        assertTrue(params.contains("rtc_app" to "better-messages/3.1.4"))
+        assertTrue(params.contains("mesh_hwenc" to "h264"))
+        assertTrue(params.contains("device_type" to "phone"))
+        assertTrue(params.none { it.first == "mesh_hwdec" })
+
+        assertNull(Mesh.appParam(null))
+        assertEquals("EasyStreamscript/1.0beta", Mesh.appParam(MeshApp("Easy Stream<script>", "1.0 beta")))
+        assertEquals("wordplus-sdk/", Mesh.appParam(MeshApp("wordplus-sdk")))
+
+        assertEquals("phone", Mesh.deviceType(android.content.res.Configuration.UI_MODE_TYPE_NORMAL, 411))
+        assertEquals("tablet", Mesh.deviceType(android.content.res.Configuration.UI_MODE_TYPE_NORMAL, 800))
+        assertNull(Mesh.deviceType(android.content.res.Configuration.UI_MODE_TYPE_TELEVISION, 540))
+    }
+
+    /** 1.0.2 (rtc-client 1.0.8): the codec policy a node sends in its join response's field 1001, names only. */
+    @Test
+    fun codecPolicy() {
+        val join = LivekitRtc.JoinResponse.newBuilder()
+            .setServerInfo(livekit.LivekitModels.ServerInfo.newBuilder().setNodeId("ND_a"))
+            .build()
+        val json = """{"camera":["h264:hw","vp8"],"screen":["vp9",7,"a-codec-name-far-too-long"],"backup":"vp8","note":"x"}"""
+        val bytes = join.toByteArray() + Mesh.lengthDelimited(Mesh.CODEC_POLICY_FIELD, json.encodeToByteArray())
+
+        // the message keeps the field it doesn't know and writes it out again, as Room.onJoinResponse reads it
+        val decoded = LivekitRtc.JoinResponse.parseFrom(bytes)
+        assertEquals("ND_a", decoded.serverInfo.nodeId)
+        val policy = Mesh.codecPolicy(decoded.toByteArray())
+        assertEquals(MeshCodecPolicy(camera = listOf("h264:hw", "vp8"), screen = listOf("vp9"), backup = "vp8"), policy)
+
+        assertNull(Mesh.codecPolicy(join.toByteArray()))
+        assertNull(Mesh.codecPolicy(Mesh.lengthDelimited(Mesh.CODEC_POLICY_FIELD, "not json".encodeToByteArray())))
+    }
+
+    /**
+     * 1.0.6 (rtc-client 1.0.16, WordPlus Mesh 1.0.53): the node's check and adapt switches and its numbers by name, as
+     * the browser's client reads them: booleans only, and numbers only, 32 at most, names of 24 characters at most.
+     */
+    @Test
+    fun codecPolicySwitchesAndTune() {
+        fun policy(json: String) = Mesh.codecPolicy(Mesh.lengthDelimited(Mesh.CODEC_POLICY_FIELD, json.encodeToByteArray()))!!
+
+        val tune = """{"failsafeS":4.5,"checkMs":3000,"flag":true,"text":"10","list":[1],"none":null,"aNameOfMoreThanTwentyFourLetters":5}"""
+        val given = policy("""{"camera":["vp9"],"check":true,"adapt":false,"tune":$tune}""")
+        assertEquals(listOf("vp9"), given.camera)
+        assertEquals(true, given.check)
+        assertEquals(false, given.adapt)
+        assertEquals(
+            "numbers only: no boolean, string, list, null or long name",
+            mapOf("failsafeS" to 4.5, "checkMs" to 3000.0),
+            given.tune,
+        )
+
+        // switches that are no JSON boolean, and a tune that is no object: none of either
+        val odd = policy("""{"check":1,"adapt":"true","tune":[1,2]}""")
+        assertNull(odd.check)
+        assertNull(odd.adapt)
+        assertNull(odd.tune)
+
+        // a node before 1.0.53 says neither
+        assertEquals(MeshCodecPolicy(camera = listOf("vp8"), backup = "vp8"), policy("""{"camera":["vp8"],"backup":"vp8"}"""))
+        assertEquals("an empty tune is a tune", emptyMap<String, Double>(), policy("""{"tune":{}}""").tune)
+
+        // at most 32 keys, the first as the node sends them (sorted)
+        val many = (0 until 40).joinToString(",") { "\"k${it.toString().padStart(2, '0')}\":$it" }
+        val capped = policy("""{"tune":{$many}}""").tune!!
+        assertEquals(32, capped.size)
+        assertEquals(31.0, capped["k31"])
+        assertNull(capped["k32"])
+    }
+
+    @Test
+    fun regionList() {
+        val regions = Mesh.regions(listJson)
+        assertNotNull(regions)
+        assertEquals(3, regions!!.size)
+        assertEquals("n2", regions[1].node)
+        assertEquals(7000L, regions[2].distance)
+        assertNull(Mesh.regions("""{"regions":[]}"""))
+        assertNull(Mesh.regions("nope"))
+
+        // A list without nodes, as LiveKit Cloud's.
+        assertNull(Mesh.regions("""{"regions":[{"region":"a","url":"wss://a.livekit.cloud","distance":"1"}]}""")!![0].node)
+    }
+
+    @Test
+    fun regionListInSignalMessage() {
+        val body = listJson.encodeToByteArray()
+        // Field 100, length-delimited: tag (100 << 3 | 2) = 802, as a varint 0xA2 0x06.
+        val message = byteArrayOf(0xA2.toByte(), 0x06) + varint(body.size) + body
+        assertEquals(3, Mesh.regionsInSignalMessage(message)?.size)
+
+        val other = LivekitRtc.SignalResponse.newBuilder().setRefreshToken("token").build().toByteArray()
+        assertNull(Mesh.regionsInSignalMessage(other))
+        assertNull(Mesh.regionsInSignalMessage(byteArrayOf(0xA2.toByte(), 0x06, 0x7F)))
+    }
+
+    @Test
+    fun refusal() {
+        val refusal = MeshRefusal.of("slot", "n2", "4")
+        assertEquals("slot", refusal.kind)
+        assertEquals("n2", refusal.node)
+        assertEquals(4_000L, refusal.retryAfterMs)
+
+        val unknown = MeshRefusal.of("weird", "", null)
+        assertNull(unknown.kind)
+        assertNull(unknown.node)
+        assertNull(unknown.retryAfterMs)
+
+        assertEquals(1_500L, MeshRefusal.retryAfterMs("1.5"))
+        assertNull(MeshRefusal.retryAfterMs("soon"))
+        val now = System.currentTimeMillis()
+        val format = SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss zzz", Locale.US).apply { timeZone = TimeZone.getTimeZone("GMT") }
+        val date = format.format(Date(now + 10_000))
+        val fromDate = MeshRefusal.retryAfterMs(date, now)!!
+        assertTrue("$fromDate", fromDate in 9_000L..10_000L)
+
+        // It survives whatever wraps it.
+        val wrapped = RuntimeException("join failed", MeshRefusedException(refusal, "Server full"))
+        assertEquals(refusal, wrapped.meshRefusal())
+        assertNull(RuntimeException("other").meshRefusal())
+    }
+
+    @Test
+    fun retryDelays() {
+        val now = 1_000_000L
+        val deadline = now + 60_000L
+
+        val full = MeshRefusedException(MeshRefusal.of("full", "n1", "2"), "Server full")
+        repeat(20) {
+            val delay = Mesh.joinRetryMs(full, deadline, now)!!
+            assertTrue("$delay", delay in 2_000L until 3_000L)
+        }
+
+        val noTime = MeshRefusedException(MeshRefusal.of("full", null, null), "Server full")
+        repeat(20) {
+            val delay = Mesh.joinRetryMs(noTime, deadline, now)!!
+            assertTrue("$delay", delay in 2_500L..7_500L)
+        }
+
+        val unreachable = RoomException.ConnectException("connection refused")
+        repeat(20) {
+            val delay = Mesh.joinRetryMs(unreachable, deadline, now)!!
+            assertTrue("$delay", delay in 1_000L until 3_000L)
+        }
+
+        assertNull(Mesh.joinRetryMs(RoomException.ConnectException("HTTP 401: invalid token"), deadline, now))
+        assertNull(Mesh.joinRetryMs(RuntimeException("x", RoomException.ConnectException("HTTP 403: no room")), deadline, now))
+        assertTrue(Mesh.isRefusedToken(RoomException.ConnectException("HTTP 401: x")))
+        assertFalse(Mesh.isRefusedToken(RoomException.ConnectException("HTTP 429: x")))
+
+        // Past the deadline.
+        assertNull(Mesh.joinRetryMs(unreachable, now + 500L, now))
+    }
+
+    @Test
+    fun serverToWaitOn() {
+        class Busy(val region: String?, val freeAt: Long)
+        val busy = listOf(Busy("us", 1), Busy("eu", 5), Busy("eu", 3))
+        assertEquals(3L, Mesh.waitOn(busy, "eu", { it.region }, { it.freeAt })!!.freeAt)
+        assertEquals(1L, Mesh.waitOn(busy, "asia", { it.region }, { it.freeAt })!!.freeAt)
+        assertEquals(1L, Mesh.waitOn(busy, null, { it.region }, { it.freeAt })!!.freeAt)
+        assertNull(Mesh.waitOn(emptyList<Busy>(), "eu", { it.region }, { it.freeAt }))
+    }
+
+    @Test
+    fun nextServer() = runTest {
+        val provider = provider()
+        provider.setSignalRegions(Mesh.regions(listJson)!!)
+
+        assertTrue(provider.hasSignalRegions())
+        assertEquals("eu", provider.homeRegion())
+        assertEquals("wss://n3.rtc.wordplus.cloud", provider.nodeEntry("n3")?.url)
+
+        // The node it was on is left out, and each server is tried once.
+        assertEquals("wss://n2.rtc.wordplus.cloud", provider.next(skipNode = "n1")?.url)
+        assertEquals("wss://n3.rtc.wordplus.cloud", provider.next(skipNode = null)?.url)
+        assertNull(provider.next(skipNode = null))
+
+        // A fresh walk tries them all again, with no node skipped.
+        provider.clearAttemptedRegions()
+        assertEquals("wss://n1.rtc.wordplus.cloud", provider.next(skipNode = null)?.url)
+
+        // A busy node is skipped.
+        provider.clearAttemptedRegions()
+        provider.skipNode("n1")
+        provider.skipNode("n2")
+        assertEquals("wss://n3.rtc.wordplus.cloud", provider.next(skipNode = null)?.url)
+    }
+
+    /**
+     * 1.0.1 (rtc-client 1.0.12): a burst node's removal, 2026-10-20. The phone joined through the burst node's own
+     * name, a drain moved its session to Limburg, and the burst node went; the list the burst node sent still starts
+     * with itself.
+     */
+    @Test
+    fun nextServerAfterDrainMove() = runTest {
+        val provider = provider("wss://n-burst.de.rtc.wordplus.cloud")
+        provider.setSignalRegions(
+            Mesh.regions(
+                """{"regions":[
+                {"region":"de1","url":"wss://n-burst.de.rtc.wordplus.cloud","distance":"0","node":"ND_burst"},
+                {"region":"gra11","url":"wss://n-fr.gra.rtc.wordplus.cloud","distance":"500000","node":"ND_fr"},
+                {"region":"de1","url":"wss://n-lim.de.rtc.wordplus.cloud","distance":"0","node":"ND_lim"}
+                ]}""",
+            )!!,
+        )
+
+        // 1.0.0 left out the session's node and so gave the dead burst node's own entry
+        assertEquals("wss://n-burst.de.rtc.wordplus.cloud", provider.next(skipNode = "ND_lim")?.url)
+        provider.clearAttemptedRegions()
+
+        val failed = "wss://n-burst.de.rtc.wordplus.cloud"
+        // the session's node first, though it comes last in the list
+        assertEquals("wss://n-lim.de.rtc.wordplus.cloud", provider.next(null, skipUrl = failed, preferNode = "ND_lim")?.url)
+        // tried once: the list goes on, still without the address that failed
+        assertEquals("wss://n-fr.gra.rtc.wordplus.cloud", provider.next(null, skipUrl = failed, preferNode = "ND_lim")?.url)
+        assertNull(provider.next(null, skipUrl = failed, preferNode = "ND_lim"))
+
+        // matched by the server alone, whatever path the signal URL carries
+        assertTrue(Mesh.sameServer("wss://n-burst.de.rtc.wordplus.cloud/rtc?x=1", "wss://n-burst.de.rtc.wordplus.cloud"))
+        assertFalse(Mesh.sameServer("wss://n-lim.de.rtc.wordplus.cloud", "wss://n-burst.de.rtc.wordplus.cloud"))
+    }
+
+    /** 1.0.1 (rtc-client 1.0.5): a failed resume moves only off a server that has gone, to one that answers. */
+    @Test
+    fun resumeMoves() {
+        assertTrue(Mesh.resumeMoves(ownAnswers = false, nextAnswers = true))
+        // its own server is up: the resume failed on the way
+        assertFalse(Mesh.resumeMoves(ownAnswers = true, nextAnswers = true))
+        // nothing answers: this client's network is down
+        assertFalse(Mesh.resumeMoves(ownAnswers = false, nextAnswers = false))
+    }
+
+    /** 1.0.1 (rtc-client 1.0.5): a resume waits four round trips, 5 s at least, at most the connect's timeout. */
+    @Test
+    fun resumeWait() {
+        assertEquals(5_000L, Mesh.resumeWaitMs(0, 10_000))
+        assertEquals(5_000L, Mesh.resumeWaitMs(200, 10_000))
+        assertEquals(8_000L, Mesh.resumeWaitMs(2_000, 10_000))
+        assertEquals(10_000L, Mesh.resumeWaitMs(28_000, 10_000))
+        assertEquals(5_000L, Mesh.resumeWaitMs(-1, 10_000))
+    }
+
+    /** 1.0.1: a server that is up answers the probe whatever its status; an address nothing listens on doesn't. */
+    @Test
+    fun serverAnswers() = runTest {
+        val server = MockWebServer()
+        server.enqueue(MockResponse().setResponseCode(404))
+        server.start()
+        try {
+            val provider = provider()
+            assertTrue(provider.serverAnswers("ws://${server.hostName}:${server.port}/rtc?access_token=x"))
+            assertEquals("/", server.takeRequest().path)
+            assertFalse(provider.serverAnswers("ws://127.0.0.1:9"))
+            assertFalse(provider.serverAnswers("not a url"))
+        } finally {
+            server.shutdown()
+        }
+        assertEquals("https://n1.rtc.wordplus.cloud/", Mesh.httpOrigin("wss://n1.rtc.wordplus.cloud/rtc?x=1"))
+        assertEquals("http://localhost:7880/", Mesh.httpOrigin("ws://localhost:7880"))
+    }
+
+    @Test
+    fun leaveListDoesNotReplaceSignalList() = runTest {
+        val provider = provider()
+        provider.setSignalRegions(Mesh.regions(listJson)!!)
+        provider.setServerReportedRegions(RegionSettings(listOf(RegionInfo("eu", "wss://rtc.wordplus.cloud", 0))))
+        assertEquals("wss://n1.rtc.wordplus.cloud", provider.next(skipNode = null)?.url)
+    }
+
+    @Test
+    fun lastListKeptWhenRefreshFails() = runTest {
+        MeshDomains.add("localhost")
+        // Nothing listens on port 9, so the refresh fails at once.
+        val provider = provider("ws://localhost:9")
+        val list = RegionSettings(listOf(RegionInfo("eu", "wss://n1.rtc.wordplus.cloud", 0, "n1")))
+        provider.setServerReportedRegions(list)
+
+        assertEquals(list, provider.fetchRegionSettings())
+    }
+
+    private fun varint(value: Int): ByteArray {
+        var rest = value
+        val bytes = mutableListOf<Byte>()
+        while (rest >= 0x80) {
+            bytes.add(((rest and 0x7F) or 0x80).toByte())
+            rest = rest ushr 7
+        }
+        bytes.add(rest.toByte())
+        return bytes.toByteArray()
+    }
+}
