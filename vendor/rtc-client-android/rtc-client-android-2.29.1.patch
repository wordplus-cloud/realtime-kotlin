+    /**
+     * What a minute of a call of 8 asks of a device (the publisher's camera with a backup, 14 tracks received): every
+     * 10 s the reports' look (both connections), the reports themselves when due (each sender, each receiver, both
+     * connections' paths), and the hardware-drop watch's camera every 5 s. Read one at a time as until 1.0.5: 108
+     * gatherings; shared: 18.
+     */
+    @Test
+    fun readsAMinuteInACallOfEight() = runBlocking {
+        val hub = MeshStatsHub()
+        val pub = Any()
+        val sub = Any()
+        val gather: suspend () -> List<Stat> = { emptyList() }
+        var separate = 0
+        val t0 = 1_000_000L
+        for (second in 0 until 60 step 5) {
+            val now = t0 + second * 1000L
+            // the hardware-drop watch's camera
+            hub.read(pub, now, gather)
+            separate++
+            if (second % 10 != 0) continue
+            // the look, then the reports at a 10 s pace: two senders, 14 receivers, both paths
+            hub.read(pub, now, gather)
+            hub.read(sub, now, gather)
+            repeat(2) { hub.read(pub, now + 100, gather) }
+            repeat(14) { hub.read(sub, now + 200, gather) }
+            separate += 2 + 14
+        }
+        assertEquals(12 + 6 * 16, separate)
+        assertEquals("the publisher every 5 s, the subscriber every 10 s", 12 + 6, hub.reads)
+    }
