+package io.livekit.android.room
+
+import io.livekit.android.room.HardwareDropRule.Layer
+import io.livekit.android.room.HardwareDropRule.Reading
+import io.livekit.android.room.MeshEncoders.Stat
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * WordPlus Mesh (1.0.5): a hardware encoder taking a camera's frames off, as @wordplus/realtime-client's own tests have
+ * it (test/encoder-watch.test.ts).
+ */
+class MeshHardwareDropsTest {
+
+    // A camera's reading: its 180p in software and its 360p in hardware, at these frames a second of what its source gives.
+    private fun layer(
+        fps: Double,
+        hardware: Boolean,
+        active: Boolean = true,
+        limit: String = "none",
+        encodeMs: Double? = null,
+        target: Double? = 600_000.0,
+        sentBps: Double = 700_000.0,
+    ) = Layer(active, fps, hardware, limit, encodeMs ?: if (hardware) 13.0 else 1.3, target, sentBps)
+
+    private fun camera(
+        fps: Double,
+        captured: Double = 15.0,
+        limit: String = "none",
+        encodeMs: Double? = null,
+        target: Double? = 600_000.0,
+        sentBps: Double = 700_000.0,
+    ) = Reading(
+        "h264",
+        captured,
+        listOf(
+            layer(fps, false, limit = limit, target = target, sentBps = sentBps),
+            layer(fps, true, limit = limit, encodeMs = encodeMs, target = target, sentBps = sentBps),
+        ),
+    )
+
+    private fun thirty(vararg fps: Double) = fps.map { camera(it) }
+
+    @Test
+    fun found() {
+        // a Windows PC's AMD encoder, 2026-10-21: 3-6 of 15 every 5 s
+        assertTrue(HardwareDropRule.dropsFrames(thirty(3.0, 4.0, 5.0, 4.0, 5.0, 6.0)))
+        // the lab's VideoToolbox under heavy grain: every layer at 0.6 for 10-15 s between 20 s at 15
+        assertTrue(HardwareDropRule.dropsFrames(thirty(15.0, 15.2, 14.2, 3.6, 0.6, 0.6)))
+        // the AMD PC that sent 17 of 17, a 5 s glitch in 30 s, and under 30 s of readings
+        assertFalse(HardwareDropRule.dropsFrames(List(6) { camera(17.0, captured = 17.0) }))
+        assertFalse(HardwareDropRule.dropsFrames(thirty(15.0, 15.0, 0.6, 15.0, 15.0, 15.0)))
+        assertFalse(HardwareDropRule.dropsFrames(thirty(3.0, 4.0, 5.0, 4.0, 5.0)))
+    }
+
+    @Test
+    fun notOtherCauses() {
+        val fps = listOf(3.0, 4.0, 5.0, 4.0, 5.0, 6.0)
+        assertFalse(HardwareDropRule.dropsFrames(fps.map { camera(it, limit = "bandwidth") }))
+        assertFalse(HardwareDropRule.dropsFrames(fps.map { camera(it, limit = "cpu") }))
+        assertFalse("a slow device", HardwareDropRule.dropsFrames(fps.map { camera(it, encodeMs = 60.0) }))
+        assertFalse("a dim room", HardwareDropRule.dropsFrames(List(6) { camera(7.0, captured = 7.0) }))
+        assertNull(HardwareDropRule.hardwareReading(Reading("h264", 15.0, listOf(layer(4.0, false), layer(0.0, true, active = false)))))
+        assertNull(HardwareDropRule.hardwareReading(camera(4.0).copy(codec = "vp8")))
+        // software short of bits: its top layer alone short of frames
+        val topShort = Reading("h264", 15.0, listOf(layer(14.9, false), layer(14.9, true), layer(2.1, true)))
+        assertFalse(HardwareDropRule.dropsFrames(List(6) { topShort }))
+        // a frozen camera, every layer on and none sending, kept nothing
+        assertEquals(0.0 to 15.0, HardwareDropRule.hardwareReading(camera(0.0)))
+    }
+
+    @Test
+    fun notAPathGoneDown() {
+        val gone = camera(0.0, target = null, sentBps = 0.0)
+        assertNull(HardwareDropRule.hardwareReading(gone))
+        assertNull(HardwareDropRule.hardwareReading(camera(2.0, sentBps = 100_000.0)))
+        assertFalse(HardwareDropRule.dropsFrames(listOf(camera(15.0), camera(15.0), camera(15.0), gone, camera(2.0, sentBps = 120_000.0), camera(15.0))))
+        assertTrue("the same frames, the path up", HardwareDropRule.dropsFrames(thirty(15.0, 15.0, 15.0, 0.0, 2.0, 15.0)))
+    }
+
+    @Test
+    fun readFromStats() {
+        val adapter = "SimulcastEncoderAdapter (libvpx, MediaCodecVideoEncoder)"
+        fun report(at: Double, frames: List<Double>, time: List<Double>): List<Stat> {
+            val stats = mutableListOf(
+                Stat("c", "codec", mapOf("mimeType" to "video/H264")),
+                Stat("m", "media-source", mapOf("framesPerSecond" to 15.0)),
+            )
+            listOf("q", "h").forEachIndexed { i, rid ->
+                stats.add(
+                    Stat(
+                        "o$rid",
+                        "outbound-rtp",
+                        mapOf(
+                            "kind" to "video", "rid" to rid, "codecId" to "c", "mediaSourceId" to "m", "active" to true,
+                            "framesEncoded" to frames[i], "totalEncodeTime" to time[i], "qualityLimitationReason" to "none",
+                            "targetBitrate" to if (i == 1) 600_000.0 else 150_000.0, "bytesSent" to at * (if (i == 1) 100 else 20),
+                            "encoderImplementation" to adapter,
+                        ),
+                    ),
+                )
+            }
+            stats.add(Stat("of", "outbound-rtp", mapOf("kind" to "video", "rid" to "f", "codecId" to "c", "active" to false, "framesEncoded" to 0.0)))
+            return stats
+        }
+        val (first, counts) = HardwareDropRule.read(report(1000.0, listOf(100.0, 100.0), listOf(0.1, 1.3)), 1000.0, null, listOf("q", "h", "f"))
+        assertNull(first)
+        val (reading, _) = HardwareDropRule.read(report(6000.0, listOf(120.0, 120.0), listOf(0.126, 1.566)), 6000.0, counts, listOf("q", "h", "f"))
+        assertEquals("h264", reading!!.codec)
+        assertEquals(15.0, reading.captured, 0.0)
+        assertEquals(listOf(4.0, 4.0, 0.0), reading.layers.map { it.fps })
+        assertEquals(listOf(false, true, false), reading.layers.map { it.hardware })
+        assertEquals(listOf(160_000.0, 800_000.0, 0.0), reading.layers.map { it.sentBps })
+        assertEquals(listOf(150_000.0, 600_000.0, null), reading.layers.map { it.target })
+        assertEquals(13.3, reading.layers[1].encodeMs!!, 0.01)
+        assertEquals(4.0 to 15.0, HardwareDropRule.hardwareReading(reading))
+    }
+
+    @Test
+    fun captureOverTheEncodings() {
+        // a camera giving 60, sent at 30, keeps them all
+        fun report(at: Double, frames: Double) = listOf(
+            Stat("c", "codec", mapOf("mimeType" to "video/H264")),
+            Stat("m", "media-source", mapOf("framesPerSecond" to 60.0)),
+            Stat(
+                "o",
+                "outbound-rtp",
+                mapOf(
+                    "kind" to "video", "codecId" to "c", "mediaSourceId" to "m", "active" to true, "framesEncoded" to frames,
+                    "totalEncodeTime" to frames * 0.01, "qualityLimitationReason" to "none", "targetBitrate" to 1_500_000.0,
+                    "bytesSent" to at * 190, "encoderImplementation" to "c2.qti.avc.encoder", "powerEfficientEncoder" to true,
+                ),
+            ),
+        )
+        val first = HardwareDropRule.read(report(1000.0, 0.0), 1000.0, null, listOf(""), 30.0).second
+        val reading = HardwareDropRule.read(report(6000.0, 150.0), 6000.0, first, listOf(""), 30.0).first!!
+        assertEquals(30.0, reading.captured, 0.0)
+        assertFalse(HardwareDropRule.dropsFrames(List(6) { reading }))
+        val uncapped = HardwareDropRule.read(report(6000.0, 150.0), 6000.0, HardwareDropRule.read(report(1000.0, 0.0), 1000.0, null, listOf("")).second, listOf("")).first!!
+        assertTrue("half of what its source gives", HardwareDropRule.dropsFrames(List(6) { uncapped }))
+    }
+
+    @Test
+    fun softwareStandIn() {
+        assertEquals(false, MeshEncoders.encoderHardware("OpenH264 (fallback from: MediaCodecVideoEncoder)", true))
+        assertEquals(false, MeshEncoders.encoderHardware("libvpx", null))
+        assertEquals(true, MeshEncoders.encoderHardware("c2.exynos.h264.encoder", null))
+    }
+
+    @Test
+    fun remembered() {
+        val store = object : MeshHardwareDrops.Store {
+            var seen = mapOf<String, Long>()
+            override fun read() = seen
+            override fun write(seen: Map<String, Long>) {
+                this.seen = seen
+            }
+        }
+        val now = 1_800_000_000_000L
+        assertTrue(MeshHardwareDrops.codecs(store, now).isEmpty())
+        MeshHardwareDrops.remember(store, "H264", now)
+        MeshHardwareDrops.remember(store, "vp8", now)
+        assertEquals("VP8 is left out", listOf("h264"), MeshHardwareDrops.codecs(store, now))
+        assertEquals(listOf("h264"), MeshHardwareDrops.codecs(store, now + 29L * 24 * 3600 * 1000))
+        assertTrue("a month on, tried again", MeshHardwareDrops.codecs(store, now + 31L * 24 * 3600 * 1000).isEmpty())
+    }
+
+    // 1.0.9: the watch's numbers from the settings, today's constants where they say nothing
+    @Test
+    fun tunedBySettings() {
+        assertEquals("no document: the constants", HardwareDropRule.Tune(), HardwareDropRule.Tune.of(MeshSettings.NONE))
+        val settings = MeshSettings.parse(
+            """{"rev":2,"set":{"watch.everyMs":10000,"tune.dropWatchS":20,"watch.warmups":0,"watch.dropShare":0.5,""" +
+                """"watch.minCapturedFps":8,"watch.maxEncodeMs":40,"watch.minTargetKbps":50,"watch.minSent":0.1}}""",
+        )!!
+        val tune = HardwareDropRule.Tune.of(settings)
+        assertEquals(HardwareDropRule.Tune(10_000, 2, 0, 0.5, 8.0, 40.0, 50_000.0, 0.1), tune)
+        // 4-6 of 15 is dropping by the constants (70%), not by a share of 25%
+        assertTrue(HardwareDropRule.dropsFrames(thirty(4.0, 5.0, 6.0, 4.0, 5.0, 6.0)))
+        assertFalse(HardwareDropRule.dropsFrames(thirty(4.0, 5.0, 6.0, 4.0, 5.0, 6.0), HardwareDropRule.Tune(share = 0.25)))
+        // two readings are the whole window when the settings say so, and a 30 ms encoder of a source giving 30 a second
+        // is within their 40 ms
+        assertTrue(HardwareDropRule.dropsFrames(thirty(3.0, 4.0), tune))
+        assertFalse(
+            "over the constants' 25 ms, and over 80% of 33",
+            HardwareDropRule.dropsFrames(listOf(3.0, 4.0, 5.0, 4.0, 5.0, 6.0).map { camera(it, captured = 30.0, encodeMs = 30.0) }),
+        )
+        assertTrue(HardwareDropRule.dropsFrames(listOf(3.0, 4.0).map { camera(it, captured = 30.0, encodeMs = 30.0) }, tune))
+    }
+
+    // 1.0.13: a dim room's camera is judged from 5 frames a second, and an encoder keeps up while it takes no more than
+    // 80% of the time between its source's frames (realtime-client 1.0.85's encoder watch)
+    @Test
+    fun ofADimRoomsCamera() {
+        val fps = listOf(3.0, 2.0, 4.0, 3.0, 2.0, 4.0)
+        // a camera giving 9-10 a second in the dark, 2-4 of them sent on every layer, its hardware at 24-26 ms a frame
+        assertTrue(HardwareDropRule.dropsFrames(fps.map { camera(it, captured = 9.5, encodeMs = 26.0) }))
+        assertFalse("under 5 a second says nothing of the encoder", HardwareDropRule.dropsFrames(fps.map { camera(it, captured = 4.0) }))
+        assertFalse("a slow device still", HardwareDropRule.dropsFrames(fps.map { camera(it, captured = 10.0, encodeMs = 90.0) }))
+        assertEquals(26.67, HardwareDropRule.slowMs(30.0), 0.01)
+        assertEquals(53.33, HardwareDropRule.slowMs(15.0), 0.01)
+        assertEquals(80.0, HardwareDropRule.slowMs(10.0), 0.01)
+        assertEquals("never under the limit itself", 25.0, HardwareDropRule.slowMs(60.0), 0.0)
+        assertEquals(25.0, HardwareDropRule.slowMs(0.0), 0.0)
+    }
+
+    @Test
+    fun rememberedAsTheSettingsSay() {
+        val store = object : MeshHardwareDrops.Store {
+            var seen = mapOf<String, Long>()
+            override fun read() = seen
+            override fun write(seen: Map<String, Long>) {
+                this.seen = seen
+            }
+        }
+        val now = 1_800_000_000_000L
+        val day = 24L * 3600 * 1000
+        MeshHardwareDrops.remember(store, "h264", now)
+        val week = MeshSettings.parse("""{"rev":1,"set":{"tune.rememberDropsDays":7}}""")!!
+        assertEquals(listOf("h264"), MeshHardwareDrops.codecs(store, now + 6 * day, week))
+        assertTrue(MeshHardwareDrops.codecs(store, now + 8 * day, week).isEmpty())
+        val none = MeshSettings.parse("""{"rev":1,"set":{"tune.rememberDropsDays":0}}""")!!
+        assertTrue("0 remembers none", MeshHardwareDrops.codecs(store, now, none).isEmpty())
+        // measured again from a moment on: what was seen before it is forgotten
+        val after = MeshSettings.parse("""{"rev":1,"set":{"tune.forgetBefore":1800000001000}}""")!!
+        assertTrue(MeshHardwareDrops.codecs(store, now + 60_000, after).isEmpty())
+        assertEquals("no document: a month", listOf("h264"), MeshHardwareDrops.codecs(store, now + 60_000))
+    }
+}
