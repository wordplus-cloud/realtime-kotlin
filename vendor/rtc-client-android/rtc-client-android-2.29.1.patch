+    /** The region list a node sent in a signal response ([REGIONS_FIELD]), or null when the message is another. */
+    fun regionsInSignalMessage(bytes: ByteArray): List<RegionInfo>? =
+        lengthDelimitedField(REGIONS_FIELD, bytes)?.let { regions(it.decodeToString()) }
+
+    /** The first length-delimited field [no] of a protobuf message's bytes, or null when it has none or can't be read. */
+    fun lengthDelimitedField(no: Int, bytes: ByteArray): ByteArray? {
+        var at = 0
+
+        fun varint(): Long? {
+            var value = 0L
+            var shift = 0
+            while (at < bytes.size && shift < 64) {
+                val byte = bytes[at++].toInt() and 0xFF
+                value = value or ((byte and 0x7F).toLong() shl shift)
+                if (byte and 0x80 == 0) return value
+                shift += 7
+            }
+            return null
+        }
+
+        while (at < bytes.size) {
+            val tag = varint() ?: return null
+            val field = (tag ushr 3).toInt()
+            when ((tag and 0x7).toInt()) {
+                0 -> varint() ?: return null
+                1 -> at += 8
+                2 -> {
+                    val length = varint()?.toInt() ?: return null
+                    if (length < 0 || at + length > bytes.size) return null
+                    if (field == no) return bytes.copyOfRange(at, at + length)
+                    at += length
+                }
+                5 -> at += 4
+                else -> return null
+            }
+        }
+        return null
+    }
+
+    /**
+     * A length-delimited field's bytes as a message carries it: its tag, its length, then the data (1.0.3's encoder
+     * reports go so, in a request with no message of LiveKit's).
+     */
+    fun lengthDelimited(no: Int, data: ByteArray): ByteArray {
+        fun varint(value: Long): ByteArray {
+            val out = java.io.ByteArrayOutputStream()
+            var n = value
+            while (n >= 0x80) {
+                out.write(((n and 0x7F) or 0x80).toInt())
+                n = n ushr 7
+            }
+            out.write(n.toInt())
+            return out.toByteArray()
+        }
+        return varint((no.toLong() shl 3) or 2) + varint(data.size.toLong()) + data
+    }
+
+    /** A region list as `/settings/regions` answers it, each entry with the node it leads to. */
+    fun regions(text: String): List<RegionInfo>? = try {
+        json.decodeFromString(RegionSettings.serializer(), text).regions.takeIf { it.isNotEmpty() }
+    } catch (e: Exception) {
+        null
+    }
